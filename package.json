{
  "name": "lyrics-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm test && npm run source:check",
    "build": "astro build && node scripts/verify-sitemap.mjs && pagefind && node scripts/generate-offline-search-manifest.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:browser": "playwright test --grep-invert @perf",
    "check": "astro check",
    "source:check": "node scripts/source-workflow.mjs --check",
    "source:sync": "node scripts/source-workflow.mjs --sync",
    "whitespace:fix": "node scripts/tidy-whitespace.mjs --write --changed",
    "whitespace:check": "node scripts/tidy-whitespace.mjs --check --changed",
    "content:review": "node --experimental-strip-types scripts/review-content.mjs",
    "perf:assets": "node scripts/report-build-assets.mjs",
    "perf:browser": "playwright test --grep @perf",
    "roman:review": "node scripts/normalize-roman.mjs --report",
    "sitemap:verify": "node scripts/verify-sitemap.mjs",
    "sitemap:verify:live": "node scripts/verify-sitemap.mjs --live",
    "kalam:plan": "python3 scripts/kalam_codex.py plan",
    "kalam:prompt": "python3 scripts/kalam_codex.py prompt",
    "kalam:run": "python3 scripts/kalam_codex.py run",
    "kalam:supervise": "python3 scripts/kalam_codex.py supervise --confirm-run",
    "kalam:status": "python3 scripts/kalam_codex.py status",
    "kalam:requeue": "python3 scripts/kalam_codex.py requeue",
    "kalam:service:install": "python3 scripts/kalam_codex.py service install",
    "kalam:service:uninstall": "python3 scripts/kalam_codex.py service uninstall",
    "kalam:validate": "python3 scripts/kalam_codex.py validate",
    "lyrics:metadata:check": "node scripts/normalize-lyric-metadata.mjs --check",
    "lyrics:metadata:fix": "node scripts/normalize-lyric-metadata.mjs --write"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/gulzar": "^5.3.0",
    "@fontsource/lateef": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.65.1",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  },
  "packageManager": "npm@12.2.2"
}
