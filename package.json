{
  "name": "lyrics-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm test && npm run source:check",
    "build": "astro build && pagefind && node scripts/generate-offline-search-manifest.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:browser": "playwright test --grep-invert @perf",
    "check": "astro check",
    "source:check": "node scripts/source-workflow.mjs --check",
    "source:sync": "node scripts/source-workflow.mjs --sync",
    "content:review": "node --experimental-strip-types scripts/review-content.mjs",
    "perf:assets": "node scripts/report-build-assets.mjs",
    "perf:browser": "playwright test --grep @perf"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/gulzar": "^5.3.0",
    "@fontsource/lateef": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.64.1",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
