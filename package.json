{
  "name": "lyrics-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm test",
    "build": "astro build && pagefind",
    "preview": "astro preview",
    "search-preview": "npm run build && astro preview",
    "basta:sync": "node scripts/sync-basta-index.mjs",
    "basta:sync:check": "node scripts/sync-basta-index.mjs --check",
    "astro": "astro",
    "basta:index:sync": "node scripts/sync-basta-index.mjs --index-only",
    "basta:index:check": "node scripts/sync-basta-index.mjs --index-only --check",
    "basta:breaks:rebuild": "node scripts/sync-basta-index.mjs --sync-breaks",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "astro": "^7.1.4"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
