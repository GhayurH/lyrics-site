{
  "name": "lyrics-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm test && npm run recitation:ids:check",
    "build": "astro build && pagefind && node scripts/generate-offline-search-manifest.mjs",
    "preview": "astro preview",
    "search-preview": "npm run build && astro preview",
    "basta:sync": "node scripts/sync-basta-index.mjs",
    "basta:sync:check": "node scripts/sync-basta-index.mjs --check",
    "astro": "astro",
    "basta:index:sync": "node scripts/sync-basta-index.mjs --index-only",
    "basta:index:check": "node scripts/sync-basta-index.mjs --index-only --check",
    "basta:breaks:rebuild": "node scripts/sync-basta-index.mjs --sync-breaks",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:browser": "playwright test --grep-invert @perf",
    "basta:kalams:audit": "node --experimental-strip-types scripts/audit-basta-kalams.mjs",
    "recitation:ids:check": "node --experimental-strip-types scripts/recitation-identities.mjs --check",
    "recitation:ids:sync": "node --experimental-strip-types scripts/recitation-identities.mjs --sync",
    "check": "npm install --no-save --package-lock=false @astrojs/check@0.9.12 typescript@6.0.2 && astro check",
    "perf:assets": "node scripts/report-build-assets.mjs",
    "basta:kalams:review": "node --experimental-strip-types scripts/audit-basta-kalams.mjs --review",
    "perf:browser": "playwright test --grep @perf"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/gulzar": "^5.3.0",
    "@fontsource/lateef": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "^7.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pagefind": "^1.5.2",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
