---
// File role: Shared, independently selectable editions and immersive reading controls.
import "../styles/reading-focus.css";
interface Props {
  ariaLabel?: string;
  className?: string;
  modeGroupLabel?: string;
  showModes?: boolean;
  hasImage?: boolean;
  imageOnly?: boolean;
  pageJump?: boolean;
}
const {
  ariaLabel = "Reading controls",
  className = "",
  modeGroupLabel = "Visible editions",
  showModes = true,
  hasImage = false,
  imageOnly = false,
  pageJump = false,
} = Astro.props as Props;
---

<div class:list={["reading-controls", className]} data-reading-controls data-pagefind-ignore aria-label={ariaLabel}>
  <button type="button" class="reading-focus-enter" data-reading-focus-enter>Reading mode</button>
  <div class="reading-focus-actions">
    <button type="button" data-reading-focus-options aria-expanded="false" aria-label="Show reading options">Options</button>
    <button type="button" data-reading-focus-exit aria-label="Exit reading mode">× Exit</button>
  </div>
  <button type="button" class="reading-focus-fullscreen" data-reading-fullscreen-toggle aria-pressed="false">Fullscreen</button>

  <div class="reading-control-group reading-view-control">
    <span class="reading-control-label">Show editions</span>
    <div class="reading-column-choices" role="group" aria-label={modeGroupLabel}>
      {hasImage && (
        <label class="reading-column-choice">
          <input type="checkbox" value="image" data-reading-column checked={imageOnly} />
          <span>Image</span>
        </label>
      )}
      {!imageOnly && (
        <label class="reading-column-choice">
          <input type="checkbox" value="urdu" data-reading-column checked />
          <span>Urdu</span>
        </label>
      )}
      {showModes && !imageOnly && (
        <label class="reading-column-choice">
          <input type="checkbox" value="roman" data-reading-column checked />
          <span>Roman</span>
        </label>
      )}
    </div>
  </div>

  {!imageOnly && (
    <label class="reading-control-group">
      <span class="reading-control-label">Text size</span>
      <select data-reading-font-size>
        <option value="small">Small</option>
        <option value="default" selected>Default</option>
        <option value="large">Large</option>
        <option value="xlarge">Extra large</option>
      </select>
    </label>
  )}
  {!imageOnly && (
    <label class="reading-control-group">
      <span class="reading-control-label">Line spacing</span>
      <select data-reading-line-spacing>
        <option value="compact">Compact</option>
        <option value="default" selected>Default</option>
        <option value="relaxed">Relaxed</option>
      </select>
    </label>
  )}
  {pageJump && (
    <form class="reading-page-jump" data-reading-page-jump>
      <label for="reading-page-number">Page</label>
      <input id="reading-page-number" name="page" type="number" min="1" step="1" inputmode="numeric" placeholder="No." required />
      <button type="submit">Go</button>
    </form>
  )}
  <button type="button" class="reading-scroll-top" data-reading-scroll-top hidden aria-label="Scroll to top">↑ Top</button>
</div>
