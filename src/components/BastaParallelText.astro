---
// File role: Shared bilingual Basta renderer with independently sized Roman and
// Urdu editions; the shared resizer keeps both columns in natural document flow.
import BastaText from "./BastaText.astro";
import type { BastaStanzaStyle } from "../lib/basta-text";
import type { StanzaPattern } from "../lib/stanza-pattern";

interface Props {
  urduText: string;
  romanText: string;
  variant: "page" | "reader";
  page: number;
  stanzaStyle?: BastaStanzaStyle;
  stanzaPattern?: StanzaPattern;
  stanzaPatterns?: Record<string, StanzaPattern>;
  indexForSearch?: boolean;
  shareStanzas?: Array<{ id: string; number: number }>;
}

const {
  urduText,
  romanText,
  variant,
  page,
  stanzaStyle = "auto",
  stanzaPattern,
  stanzaPatterns,
  indexForSearch = false,
  shareStanzas,
} = Astro.props as Props;
const isPage = variant === "page";
---

<div class:list={["basta-parallel-kalams", `basta-parallel-kalams-${variant}`]}>
  <section
    class={isPage ? "basta-page-text basta-page-roman" : "basta-reader-column basta-reader-roman"}

    lang="en"
    dir="ltr"
    aria-label={`Roman Urdu text of Basta page ${page}`}
  >
    <BastaText text={romanText} className={isPage ? "basta-roman-text" : "basta-reader-text"} stanzaStyle={stanzaStyle} stanzaPattern={stanzaPattern} stanzaPatterns={stanzaPatterns} indexForSearch={indexForSearch} shareStanzas={shareStanzas} edition="roman" />
  </section>
  <section
    class={isPage ? "basta-page-text basta-page-urdu" : "basta-reader-column basta-reader-urdu"}

    lang="ur"
    dir="rtl"
    aria-label={`Urdu text of Basta page ${page}`}
  >
    <BastaText text={urduText} className={isPage ? "basta-urdu-text" : "basta-reader-text"} stanzaStyle={stanzaStyle} stanzaPattern={stanzaPattern} stanzaPatterns={stanzaPatterns} indexForSearch={indexForSearch} shareStanzas={shareStanzas} edition="original" />
  </section>
</div>
