---
// File role: Shared bilingual Basta renderer with independently sized Roman and
// Urdu editions; the shared browser controller synchronizes scroll percentages.
import BastaText from "./BastaText.astro";
import type { BastaStanzaStyle } from "../lib/basta-text";

interface Props {
  urduText: string;
  romanText: string;
  variant: "page" | "reader";
  page: number;
  stanzaStyle?: BastaStanzaStyle;
}

const {
  urduText,
  romanText,
  variant,
  page,
  stanzaStyle = "auto",
} = Astro.props as Props;
const isPage = variant === "page";
---

<div class:list={["basta-parallel-kalams", `basta-parallel-kalams-${variant}`]}>
  <section
    class={isPage ? "basta-page-text basta-page-roman" : "basta-reader-column basta-reader-roman"}
    data-synced-scroll-panel
    lang="en"
    dir="ltr"
    aria-label={`Roman Urdu text of Basta page ${page}`}
  >
    <BastaText text={romanText} className={isPage ? "basta-roman-text" : "basta-reader-text"} stanzaStyle={stanzaStyle} />
  </section>
  <section
    class={isPage ? "basta-page-text basta-page-urdu" : "basta-reader-column basta-reader-urdu"}
    data-synced-scroll-panel
    lang="ur"
    dir="rtl"
    aria-label={`Urdu text of Basta page ${page}`}
  >
    <BastaText text={urduText} className={isPage ? "basta-urdu-text" : "basta-reader-text"} stanzaStyle={stanzaStyle} />
  </section>
</div>
