---
/* File role: Render source stanzas and six-verse 4+2 groups consistently in Urdu and Roman. */
import { layoutLyricStanzas, lyricStanzaClassNames, lyricLineClassName } from "../lib/lyric-stanzas";
import type { StanzaPattern } from "../lib/stanza-pattern";
import type { StanzaLink } from "../lib/stanza-links";

interface Props {
  text: string;
  className: string;
  stanzaPattern?: StanzaPattern;
  /** Index the displayed verses directly rather than duplicating the poem in hidden HTML. */
  indexForSearch?: boolean;
  searchTitle?: string;
  stanzaLinks?: StanzaLink[];
  edition?: "original" | "roman";
}

const { text, className, stanzaPattern, indexForSearch = false, searchTitle, stanzaLinks = [], edition = "original" } = Astro.props as Props;
const stanzas = layoutLyricStanzas(text, stanzaPattern);
const openingVerse = stanzas.flat().find((line) => !line.number);
const normalized = (value: string) => value.trim().normalize("NFKC").toLocaleLowerCase();
const openingRepeatsTitle = Boolean(openingVerse && searchTitle &&
  normalized(openingVerse.text) === normalized(searchTitle));
---

<div class:list={[className, "lyric-reading-text"]} data-pagefind-body={indexForSearch ? true : undefined}>
  {stanzas.map((stanza, index) => (
    <div class={lyricStanzaClassNames(stanza, stanzaPattern)}
      id={stanzaLinks[index]?.id} data-stanza-key={stanzaLinks[index]?.key}
      data-stanza-label={stanzaLinks[index]?.label} data-stanza-edition={edition}>
      {stanza.map((line) => (
        <>
          <span class={lyricLineClassName(line)}
            data-pagefind-ignore={indexForSearch && (line.number ||
              (openingRepeatsTitle && line === openingVerse)) ? true : undefined}>{line.text}</span>
          {"\n"}
        </>
      ))}
    </div>
  ))}
</div>
