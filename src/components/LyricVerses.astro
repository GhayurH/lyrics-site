---
/* File role: Render source stanzas and six-verse 4+2 groups consistently in Urdu and Roman. */
import { layoutLyricStanzas, lyricStanzaClassNames, lyricLineClassName } from "../lib/lyric-stanzas";

interface Props {
  text: string;
  className: string;
  sixVerseLayout?: "pairs";
}

const { text, className, sixVerseLayout } = Astro.props as Props;
const stanzas = layoutLyricStanzas(text);
---

<div class:list={[className, "lyric-reading-text"]}>
  {stanzas.map((stanza) => (
    <div class={lyricStanzaClassNames(stanza, sixVerseLayout)}>
      {stanza.map((line) => (
        <span class={lyricLineClassName(line)}>{line.text}</span>
      ))}
    </div>
  ))}
</div>
