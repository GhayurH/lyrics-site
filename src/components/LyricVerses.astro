---
/* File role: Render source stanzas and six-verse 4+2 groups consistently in Urdu and Roman. */
import { layoutLyricStanzas } from "../lib/lyric-stanzas";

interface Props {
  text: string;
  className: string;
}

const { text, className } = Astro.props as Props;
const stanzas = layoutLyricStanzas(text);
---

<div class:list={[className, "lyric-reading-text"]}>
  {stanzas.map((stanza) => (
    <div class:list={["lyric-stanza", stanza.filter((line) => !line.number).length === 6 && "lyric-stanza-six"]}>
      {stanza.map((line) => (
        <span class={line.number ? "poetry-stanza-number" : "lyric-verse"}>{line.text}</span>
      ))}
    </div>
  ))}
</div>
