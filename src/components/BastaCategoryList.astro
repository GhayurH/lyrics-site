---
// File role: Reuse canonical lyric cards for entries in the Basta index without offering lyric-only favorites.
import type { BastaCategoryEntry } from "../lib/basta-categories";
import { toBastaCardData } from "../lib/basta-categories";
import LyricCard from "./LyricCard.astro";

interface Props {
  entries: BastaCategoryEntry[];
}

const { entries } = Astro.props as Props;
---

<ul class="lyric-list">
  {entries.map((entry) => (
    <LyricCard lyric={toBastaCardData(entry)} saveable={false} />
  ))}
</ul>
