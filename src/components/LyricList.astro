---
// File role: Shared category card list: lays out standalone and Basta entries in one flex container for consistent wrapping and spacing.
import type { CollectionEntry } from "astro:content";
import { toLyricCardData } from "../lib/catalog";
import type { BastaCategoryEntry } from "../lib/basta-categories";
import { toBastaCardData } from "../lib/basta-categories";
import LyricCard from "./LyricCard.astro";

interface Props {
  lyrics: CollectionEntry<"lyrics">[];
  bastaEntries?: BastaCategoryEntry[];
  showKalamType?: boolean;
}

const { lyrics, bastaEntries = [], showKalamType = false } = Astro.props as Props;
---

<ul class="lyric-list">
  {
    lyrics.map((entry) => (
      <LyricCard
        lyric={toLyricCardData(entry, true)}
        showKalamType={showKalamType}
      />
    ))
  }
  {
    bastaEntries.map((entry) => (
      <LyricCard
        lyric={toBastaCardData(entry)}
        showKalamType={showKalamType}
        saveable={false}
      />
    ))
  }
</ul>
