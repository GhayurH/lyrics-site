---
// File role: Shared lyric-card list: maps collection entries to the canonical lightweight card model and renders LyricCard components.
import type { CollectionEntry } from "astro:content";
import { toLyricCardData } from "../lib/catalog";
import LyricCard from "./LyricCard.astro";

interface Props {
  lyrics: CollectionEntry<"lyrics">[];
  showKalamType?: boolean;
}

const { lyrics, showKalamType = false } = Astro.props as Props;
---

<ul class="lyric-list">
  {
    lyrics.map((entry) => (
      <LyricCard
        lyric={toLyricCardData(entry, true)}
        showKalamType={showKalamType}
      />
    ))
  }
</ul>
