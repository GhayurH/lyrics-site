---
// File role: Reusable Basta index table: renders structured index entries with the correct Urdu/Roman direction, section headings, and page links.
import type { BastaIndexEntry } from "../lib/basta";

interface Props {
  entries: BastaIndexEntry[];
  edition?: "urdu" | "roman";
  heading?: boolean;
  showSectionHeadings?: boolean;
  linkMode?: "page" | "continuous";
}

const {
  entries,
  edition = "urdu",
  heading = true,
  showSectionHeadings = true,
  linkMode = "page",
} = Astro.props as Props;

const roman = edition === "roman";

const groups = new Map<string, BastaIndexEntry[]>();
for (const entry of entries) {
  const section = roman
    ? (entry.sectionRoman ?? entry.section ?? "")
    : (entry.section ?? "");
  const group = groups.get(section) ?? [];
  group.push(entry);
  groups.set(section, group);
}
---

<section
  class:list={[
    "basta-index-table-section",
    roman ? "basta-index-table-roman" : "basta-index-table-urdu",
  ]}
  lang={roman ? "en" : "ur"}
  dir={roman ? "ltr" : "rtl"}
>
  {heading && <h2>{roman ? "Index" : "اشاریہ"}</h2>}

  {
    entries.length === 0 ? (
      <p class="basta-index-empty">
        {roman
          ? "The Roman index has not been added yet."
          : "اشاریہ ابھی شامل نہیں کیا گیا۔"}
      </p>
    ) : (
      <div class="basta-index-groups">
        {
          [...groups.entries()].map(([section, sectionEntries]) => {
            const hasHaal = sectionEntries.some((entry) =>
              Boolean(
                roman
                  ? (entry.romanHaal?.trim() || entry.haal?.trim() || "")
                  : (entry.haal?.trim() || ""),
              ),
            );

            return (
              <section class="basta-index-group">
                {showSectionHeadings && section && <h3>{section}</h3>}

                <div class="basta-index-table-wrap">
                  <table
                    class:list={[
                      "basta-index-table",
                      hasHaal
                        ? "basta-index-table-with-haal"
                        : "basta-index-table-without-haal",
                    ]}
                  >
                    <colgroup>
                      <col class="basta-index-col-serial" />
                      <col class="basta-index-col-name" />
                      {hasHaal && <col class="basta-index-col-haal" />}
                      <col class="basta-index-col-page" />
                    </colgroup>

                    <thead>
                      <tr>
                        <th scope="col">{roman ? "Serial" : "نمبر"}</th>
                        <th scope="col">{roman ? "Name" : "عنوان"}</th>
                        {hasHaal && (
                          <th scope="col">{roman ? "Haal" : "حال"}</th>
                        )}
                        <th scope="col">{roman ? "Page" : "صفحہ"}</th>
                      </tr>
                    </thead>

                    <tbody>
                      {
                        sectionEntries.map((entry) => {
                          const name = roman
                            ? (entry.romanName?.trim() || entry.name)
                            : entry.name;
                          const haal = roman
                            ? (entry.romanHaal?.trim() || entry.haal || "")
                            : (entry.haal ?? "");
                          const href =
                            linkMode === "continuous"
                              ? `#page-${entry.page}`
                              : `/basta/${entry.page}/`;

                          return (
                            <tr>
                              <td class="basta-index-entry-number" dir="ltr">
                                <a href={href}>
                                  {entry.number !== undefined ? entry.number : "—"}
                                </a>
                              </td>

                              <td>
                                <a href={href}>{name || "—"}</a>
                              </td>

                              {hasHaal && (
                                <td>
                                  <a href={href}>{haal || "—"}</a>
                                </td>
                              )}

                              <td class="basta-index-target-page" dir="ltr">
                                <a href={href}>{entry.page}</a>
                              </td>
                            </tr>
                          );
                        })
                      }
                    </tbody>
                  </table>
                </div>
              </section>
            );
          })
        }
      </div>
    )
  }
</section>
