---
// File role: Shared Basta single-language text renderer: turns explicit between-kalam markers into clean visual dividers while preserving stanza whitespace.
import { bastaVerseClassNames, layoutBastaKalam, splitBastaKalams, type BastaStanzaStyle } from "../lib/basta-text";
import { fragmentStanzaPattern, type StanzaPattern } from "../lib/stanza-pattern";
import { stanzaNumberValue } from "../lib/stanza-numbers";

interface Props {
  text: string;
  className: string;
  indentStanzas?: boolean;
  stanzaStyle?: BastaStanzaStyle;
  stanzaPattern?: StanzaPattern;
  stanzaPatterns?: Record<string, StanzaPattern>;
  indexForSearch?: boolean;
  shareStanzas?: Array<{ id: string; number: number }>;
  edition?: "original" | "roman";
}

const { text, className, indentStanzas = true, stanzaStyle = "auto", stanzaPattern, stanzaPatterns, indexForSearch = false, shareStanzas, edition = "original" } = Astro.props as Props;
const kalams = splitBastaKalams(text);
const targets = new Map((shareStanzas ?? []).map((stanza) => [stanza.number, stanza.id]));
const stanzaTarget = (value?: string) => value === undefined ? undefined : targets.get(stanzaNumberValue(value) ?? -1);
const editionId = (id?: string) => id ? id + (edition === "roman" ? "-roman" : "") : undefined;
---

<div class={className} data-pagefind-body={indexForSearch ? true : undefined}>
  {
    kalams.map((kalam, index) => (
      <>
        {index > 0 && (
          <div class="basta-kalam-break" role="separator" aria-label="Kalam separator">
            <span aria-hidden="true">✦</span>
          </div>
        )}
        <div class="basta-kalam-text"
          id={shareStanzas?.length === 0 ? editionId(`passage-${index + 1}`) : undefined}
          data-stanza-key={shareStanzas?.length === 0 ? `passage-${index + 1}` : undefined}
          data-stanza-label={shareStanzas?.length === 0 ? "Complete kalam" : undefined}
          data-stanza-edition={edition}>
          {layoutBastaKalam(kalam, indentStanzas, stanzaStyle, false, fragmentStanzaPattern(stanzaPattern, stanzaPatterns, index)).filter((line) => !line.hidden).map((line) => (
            <>
              <span class={bastaVerseClassNames(line)}
                id={editionId(stanzaTarget(line.stanzaNumber))}
                data-stanza-key={stanzaTarget(line.stanzaNumber)}
                data-stanza-label={line.stanzaNumber ? `Stanza ${stanzaNumberValue(line.stanzaNumber)}` : undefined}
                data-stanza-edition={edition}
                data-stanza-fragment={stanzaTarget(line.stanzaNumber) ? true : undefined}
                data-pagefind-ignore={indexForSearch && Boolean(line.stanzaNumber) ? true : undefined}>{line.text}</span>
              {"\n"}
            </>
          ))}
        </div>
      </>
    ))
  }
</div>
