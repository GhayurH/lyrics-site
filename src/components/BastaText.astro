---
// File role: Shared Basta single-language text renderer: turns explicit between-kalam markers into clean visual dividers while preserving stanza whitespace.
import { bastaVerseClassNames, layoutBastaKalam, splitBastaKalams, type BastaStanzaStyle } from "../lib/basta-text";
import { fragmentStanzaPattern, type StanzaPattern } from "../lib/stanza-pattern";

interface Props {
  text: string;
  className: string;
  indentStanzas?: boolean;
  stanzaStyle?: BastaStanzaStyle;
  stanzaPattern?: StanzaPattern;
  stanzaPatterns?: Record<string, StanzaPattern>;
  indexForSearch?: boolean;
}

const { text, className, indentStanzas = true, stanzaStyle = "auto", stanzaPattern, stanzaPatterns, indexForSearch = false } = Astro.props as Props;
const kalams = splitBastaKalams(text);
---

<div class={className} data-pagefind-body={indexForSearch ? true : undefined}>
  {
    kalams.map((kalam, index) => (
      <>
        {index > 0 && (
          <div class="basta-kalam-break" role="separator" aria-label="Kalam separator">
            <span aria-hidden="true">✦</span>
          </div>
        )}
        <div class="basta-kalam-text">
          {layoutBastaKalam(kalam, indentStanzas, stanzaStyle, false, fragmentStanzaPattern(stanzaPattern, stanzaPatterns, index)).filter((line) => !line.hidden).map((line) => (
            <>
              <span class={bastaVerseClassNames(line)}
                data-pagefind-ignore={indexForSearch && Boolean(line.stanzaNumber) ? true : undefined}>{line.text}</span>
              {"\n"}
            </>
          ))}
        </div>
      </>
    ))
  }
</div>
