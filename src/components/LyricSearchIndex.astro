---
import type { CollectionEntry } from "astro:content";
import { getLyricKalamTypes, getLyricReciters } from "../lib/lyrics";
import { searchIndexAliases } from "../lib/search-normalization";
interface Props { lyric: CollectionEntry<"lyrics"> }
const { lyric } = Astro.props as Props;
const { data } = lyric;
const categories = getLyricKalamTypes(data);
const reciters = getLyricReciters(data);
const displayHaal = data.romanHaal?.trim() || data.haal;
const searchTerms = [
  data.alternateTitle,
  data.poet,
  ...reciters,
  data.occasion,
  data.haal,
  data.romanHaal,
  ...categories,
  ...data.tags,
  ...data.aliases,
  // Pagefind indexes metadata too. Keep spelling variants searchable without
  // putting titles, aliases, and a second copy of the poem into excerpts.
  searchIndexAliases([data.title, data.alternateTitle, data.romanLyrics, lyric.body].filter(Boolean).join(" ")),
].filter(Boolean).join(" ");
---
<div class="pagefind-data" data-pagefind-ignore aria-hidden="true">
      <span data-pagefind-meta="searchTerms">{searchTerms}</span>
      <span data-pagefind-filter="collection">Lyrics</span>
      <span data-pagefind-meta="collection">Standalone kalam</span>
      {data.alternateTitle && data.alternateTitle.trim().toLocaleLowerCase() !== data.title.trim().toLocaleLowerCase() &&
        <span data-pagefind-meta="roman_title">{data.alternateTitle}</span>}
      {categories.map((category) => <span data-pagefind-filter="kalamType">{category}</span>)}
      <span data-pagefind-filter="language">{data.language}</span>

      {displayHaal && <span data-pagefind-filter="haal">{displayHaal}</span>}
      {data.poet && <span data-pagefind-filter="poet">{data.poet}</span>}
      {reciters.map((reciter) => <span data-pagefind-filter="reciter">{reciter}</span>)}
      {data.occasion && <span data-pagefind-filter="occasion">{data.occasion}</span>}
      {data.tags.map((tag) => <span data-pagefind-filter="tag">{tag}</span>)}
    </div>
