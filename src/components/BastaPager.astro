---
interface Props {
  currentPage?: number;
  previousHref?: string;
  nextHref?: string;
  previousLabel?: string;
  nextLabel?: string;
  availablePages: number[];
  indexStartPage: number;
  indexEndPage: number;
}

const {
  currentPage,
  previousHref,
  nextHref,
  previousLabel = "← Previous",
  nextLabel = "Next →",
  availablePages,
  indexStartPage,
  indexEndPage,
} = Astro.props as Props;
---

<nav
  class="basta-pager"
  aria-label="Basta page navigation"
  data-pagefind-ignore
>
  {
    previousHref ? (
      <a class="basta-nav-button" href={previousHref}>
        {previousLabel}
      </a>
    ) : (
      <span class="basta-nav-button is-disabled" aria-disabled="true">
        {previousLabel}
      </span>
    )
  }

  <form class="basta-jump-form" data-basta-jump-form>
    <label>
      <span>Go to page</span>
      <input
        name="page"
        type="number"
        min={availablePages[0]}
        max={availablePages[availablePages.length - 1]}
        value={currentPage}
        inputmode="numeric"
        required
      />
    </label>
    <button type="submit">Go</button>
  </form>

  {
    nextHref ? (
      <a class="basta-nav-button" href={nextHref}>
        {nextLabel}
      </a>
    ) : (
      <span class="basta-nav-button is-disabled" aria-disabled="true">
        {nextLabel}
      </span>
    )
  }
</nav>

<script
  is:inline
  define:vars={{
    availableBastaPages: availablePages,
    bastaIndexStartPage: indexStartPage,
    bastaIndexEndPage: indexEndPage,
  }}
>
  document.querySelectorAll("[data-basta-jump-form]").forEach((form) => {
    const input = form.querySelector('input[name="page"]');

    input?.addEventListener("input", () => {
      input.setCustomValidity("");
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const page = Number(input?.value);

      if (!Number.isInteger(page)) {
        input?.setCustomValidity("Enter a valid page number.");
        input?.reportValidity();
        return;
      }

      if (
        page >= bastaIndexStartPage &&
        page <= bastaIndexEndPage
      ) {
        window.location.href = "/basta/index/";
        return;
      }

      if (!availableBastaPages.includes(page)) {
        input?.setCustomValidity("That page is not available.");
        input?.reportValidity();
        return;
      }

      window.location.href = `/basta/${page}/`;
    });
  });
</script>
