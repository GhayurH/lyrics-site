---
// File role: Reusable Basta previous/next navigation and direct-page jump UI; validation/routing logic lives in the shared Basta navigation client.
interface Props {
  currentPage?: number;
  previousHref?: string;
  nextHref?: string;
  previousLabel?: string;
  nextLabel?: string;
  availablePages: number[];
  indexStartPage: number;
  indexEndPage: number;
}

const {
  currentPage,
  previousHref,
  nextHref,
  previousLabel = "← Previous",
  nextLabel = "Next →",
  availablePages,
  indexStartPage,
  indexEndPage,
} = Astro.props as Props;
---

<nav class="basta-pager" aria-label="Basta page navigation" data-pagefind-ignore>
  {
    previousHref ? (
      <a class="basta-nav-button" href={previousHref}>{previousLabel}</a>
    ) : (
      <span class="basta-nav-button is-disabled" aria-disabled="true">{previousLabel}</span>
    )
  }

  <form
    class="basta-jump-form"
    data-basta-jump-form
    data-available-pages={availablePages.join(",")}
    data-index-start-page={indexStartPage}
    data-index-end-page={indexEndPage}
  >
    <label>
      <span>Go to page</span>
      <input
        name="page"
        type="number"
        min={availablePages[0]}
        max={availablePages.at(-1)}
        value={currentPage}
        inputmode="numeric"
        required
      />
    </label>
    <button type="submit">Go</button>
  </form>

  {
    nextHref ? (
      <a class="basta-nav-button" href={nextHref}>{nextLabel}</a>
    ) : (
      <span class="basta-nav-button is-disabled" aria-disabled="true">{nextLabel}</span>
    )
  }
</nav>

<script>
  import { initBastaPageJumps } from "../client/basta-navigation";
  initBastaPageJumps();
</script>
