---
// File role: Server-rendered Basta page unit for the initially loaded continuous-reader chunk; its DOM contract is mirrored by the streaming client.
import type { BastaReaderPageData } from "../lib/basta";
import BastaParallelText from "./BastaParallelText.astro";
import BastaText from "./BastaText.astro";
import settings from "../data/basta/settings.json";

interface Props {
  page: BastaReaderPageData;
}

const { page } = Astro.props as Props;
---

<section
  class:list={[
    "basta-reader-page",
    page.imageOnly && "basta-reader-page-image-only",
    !page.hasRoman && !page.imageOnly && "basta-reader-page-no-roman",
  ]}
  id={`page-${page.page}`}
  data-basta-page={page.page}
  data-page-has-roman={String(page.hasRoman)}
  data-synced-scroll-root
>
  {
    page.imageOnly ? (
      <figure class="basta-reader-original-image">
        <img
          src={page.originalImage}
          alt={`Original scan of Basta page ${page.page}`}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ) : page.hasRoman ? (
      <div class="basta-reader-page-grid basta-reader-page-grid-with-roman">
        <figure class="basta-reader-original-image" data-synced-scroll-panel>
          <img
            src={page.originalImage}
            alt={`Original scan of Basta page ${page.page}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <BastaParallelText
          urduText={page.urduText}
          romanText={page.romanText}
          variant="reader"
          stanzaStyle={page.stanzaStyle}
          page={page.page}
        />
      </div>
    ) : (
      <div class="basta-reader-page-grid">
        <figure class="basta-reader-original-image" data-reading-image-extra>
          <img src={page.originalImage} alt={`Original scan of Basta page ${page.page}`} loading="lazy" decoding="async" />
        </figure>
        <section class="basta-reader-column basta-reader-roman" lang="en" dir="ltr" aria-label={`Roman Urdu text of Basta page ${page.page}`}>
          <p class="basta-transliteration-missing">No transliteration available for this page.</p>
        </section>
        <section class="basta-reader-column basta-reader-urdu" lang="ur" dir="rtl" aria-label={`Urdu text of Basta page ${page.page}`}>
          <BastaText text={page.urduText} className="basta-reader-text" indentStanzas={page.page >= settings.romanLyricsStartPage} stanzaStyle={page.stanzaStyle} />
        </section>
      </div>
    )
  }
  <p class="basta-reader-page-number" dir="ltr">{page.page}</p>
  {page.showBreak && <hr class="basta-reader-page-break" aria-hidden="true" />}
</section>
