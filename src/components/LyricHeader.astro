---
import type { CollectionEntry } from "astro:content";
import FavoriteButton from "./FavoriteButton.astro";
import ReaderSubnav from "./ReaderSubnav.astro";
import { getLyricKalamTypes, getLyricReciters, searchUrl, slugifyKalamType } from "../lib/lyrics";
import { recitationLyricId } from "../lib/lyrics-data";
import { discoveryHref } from "../lib/discovery";
interface Props { lyric: CollectionEntry<"lyrics"> }
const { lyric } = Astro.props as Props;
const { data } = lyric;
const categories = getLyricKalamTypes(data);
const reciters = getLyricReciters(data);
const displayHaal = data.romanHaal?.trim() || data.haal;
---
<header class="lyric-header">
      <ReaderSubnav ariaLabel="Lyric navigation" items={categories.map((category) => ({
        label: `← ${category}`, href: `/categories/${slugifyKalamType(category)}/`,
      }))} />

      <div class="lyric-header-title-row">
        <div class="lyric-title-block">
           <h1
            class="kalam-reading-title"
            lang={data.lang}
            dir={data.direction}
            data-pagefind-meta="title"
          >
            {data.title}
          </h1>

          {
            data.alternateTitle && (
              <p class="alternate-title kalam-reading-title" lang="en" dir="ltr">
                {data.alternateTitle}
              </p>
            )
          }
        </div>

        <div class="lyric-header-actions" data-pagefind-ignore>
           <FavoriteButton lyricId={lyric.id} />
           <button type="button" class="lyric-correction-action" data-correction-open data-source-id={lyric.id}>Suggest correction</button>
           <a class="lyric-add-recitation" href={`/recite/?add=${encodeURIComponent("lyric:" + recitationLyricId(lyric))}`}>Add to set</a>
        </div>
      </div>

      <details class="lyric-metadata-disclosure">
        <summary><strong>About this kalam</strong>{displayHaal && <span>{displayHaal}</span>}{data.poet && <span>· {data.poet}</span>}</summary>
      <dl class="lyric-details">
        <div>
          <dt>Language</dt>
          <dd>
            <a href={discoveryHref("languages", data.language.trim())}>
              {data.language}
            </a>
          </dd>
        </div>

        <div>
          <dt>Kalam Type</dt>
          <dd>
            {categories.map((category, index) => (
              <Fragment>
                {index > 0 && " · "}
                <a href={searchUrl({ collection: "Lyrics", kalamType: category })}>{category}</a>
              </Fragment>
            ))}
          </dd>
        </div>

         {
          displayHaal && (
            <div>
              <dt>Haal</dt>
              <dd>
                <a href={searchUrl({ collection: "Lyrics", haal: displayHaal })}>
                  {displayHaal}
                </a>
              </dd>
            </div>
          )
        }

        {
          data.poet && (
            <div>
              <dt>Poet</dt>
              <dd>
                <a href={discoveryHref("poets", data.poet.trim())}>
                  {data.poet}
                </a>
              </dd>
            </div>
          )
        }

        {
          reciters.length > 0 && (
            <div>
              <dt>{reciters.length === 1 ? "Reciter" : "Reciters"}</dt>
              <dd>
                {reciters.map((reciter, index) => (
                  <Fragment>
                    {index > 0 && " · "}
                    <a href={searchUrl({ collection: "Lyrics", reciter })}>{reciter}</a>
                  </Fragment>
                ))}
              </dd>
            </div>
          )
        }

        {
          data.occasion && (
            <div>
              <dt>Occasion</dt>
              <dd>
                <a href={discoveryHref("occasions", data.occasion.trim())}>
                  {data.occasion}
                </a>
              </dd>
            </div>
          )
        }

        {
          data.year && (
            <div>
              <dt>Year</dt>
              <dd>{data.year}</dd>
            </div>
          )
        }
      </dl>
      </details>

    </header>
