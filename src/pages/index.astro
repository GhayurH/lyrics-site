---
// File role: Browse landing route: groups published lyrics by Kalam Type and surfaces compact category previews plus the Basta entry point.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LyricList from "../components/LyricList.astro";
import {
  compareKalamTypes,
  compareLyrics,
  getLyricKalamType,
  slugifyKalamType,
} from "../lib/lyrics";

const HOME_PREVIEW_COUNT = 5;

const lyrics = (
  await getCollection("lyrics", ({ data }) => data.published)
).sort(compareLyrics);

const grouped = new Map<string, typeof lyrics>();
for (const lyric of lyrics) {
  const kalamType = getLyricKalamType(lyric.data);
  const entries = grouped.get(kalamType) ?? [];
  entries.push(lyric);
  grouped.set(kalamType, entries);
}

const kalamTypes = [...grouped.entries()].sort(([a], [b]) =>
  compareKalamTypes(a, b),
);
---

<BaseLayout
  title="Kalam Archive"
  description="Browse Urdu nohas, salams, manqabats and other kalam by type, alongside the Basta archive."
>
  <section class="hero hero-compact home-hero">
    <h1>Kalam Archive</h1>
    <p>
      Browse Urdu nohas, salams, manqabats and other kalam by type, search the archive, or read the complete Basta.
    </p>

    <div class="hero-actions">
      <a class="button" href="/search/">Search the archive</a>
      <a class="button button-secondary" href="/about/">About / Contact</a>
    </div>
  </section>

  <section class="home-categories" aria-labelledby="kalam-types-heading">
    <div class="section-heading home-section-heading">
      <div>
        <p class="eyebrow">Browse</p>
        <h2 id="kalam-types-heading">Kalam Types</h2>
      </div>
      <p>{lyrics.length} entries</p>
    </div>

    <div class="category-preview-stack">
      {
        kalamTypes.map(([kalamType, entries]) => {
          const typeSlug = slugifyKalamType(kalamType);
          const previewEntries = entries.slice(0, HOME_PREVIEW_COUNT);

          return (
            <section
              class="category-preview-section"
              id={typeSlug}
              aria-labelledby={`${typeSlug}-heading`}
            >
              <div class="category-preview-heading">
                <div>
                  <h3 id={`${typeSlug}-heading`}>{kalamType}</h3>
                  <p>
                    {entries.length} {entries.length === 1 ? "entry" : "entries"}
                  </p>
                </div>

                <a
                  class="button button-secondary category-see-all"
                  href={`/categories/${typeSlug}/`}
                >
                  See all {kalamType}
                </a>
              </div>

              <LyricList lyrics={previewEntries} />

              {entries.length > HOME_PREVIEW_COUNT && (
                <div class="category-preview-footer">
                  <a href={`/categories/${typeSlug}/`}>
                    See all {entries.length} {kalamType} →
                  </a>
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </section>

  <section class="home-basta" aria-labelledby="basta-heading">
    <div class="section-heading home-section-heading">
      <div>
        <p class="eyebrow">Book archive</p>
        <h2 id="basta-heading">Basta</h2>
      </div>
      <a href="/basta/">Open Basta →</a>
    </div>

    <div class="basta-home-card">
      <a
        class="basta-home-cover-link"
        href="/basta/"
        aria-label="Open Basta"
      >
        <img
          src="/images/basta/original/001.png"
          alt="Original first page of Basta"
          loading="lazy"
        />
      </a>

      <div class="basta-home-copy">
        <h3>Basta</h3>
        <p>
          Browse the original page scans alongside cleaned Urdu text and Roman
          Urdu where available.
        </p>
        <a class="button" href="/basta/">Open Basta</a>
      </div>
    </div>
  </section>

  <section class="home-about-cta" aria-labelledby="home-about-heading">
    <div>
      <p class="eyebrow">About this archive</p>
      <h2 id="home-about-heading">Corrections, additions or questions?</h2>
      <p>
        Read about the project or contact the site owner from the dedicated
        About / Contact page.
      </p>
    </div>
    <a class="button button-secondary" href="/about/#contact">About / Contact</a>
  </section>
</BaseLayout>
