---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LyricList from "../components/LyricList.astro";
import {
  compareCategories,
  compareLyrics,
  getLyricCategory,
  slugifyCategory,
} from "../lib/lyrics";

const lyrics = (
  await getCollection("lyrics", ({ data }) => data.published)
).sort(compareLyrics);

const grouped = new Map<string, typeof lyrics>();
for (const lyric of lyrics) {
  const category = getLyricCategory(lyric.data);
  const entries = grouped.get(category) ?? [];
  entries.push(lyric);
  grouped.set(category, entries);
}

const categories = [...grouped.entries()].sort(([a], [b]) =>
  compareCategories(a, b),
);
---

<BaseLayout
  title="Kalam Archive"
  description="A searchable collection of Urdu nohas, salams, manqabats and other kalam."
>
  <section class="hero hero-compact">
    <p class="eyebrow">Urdu &amp; Roman Urdu</p>
    <h1>Kalam Archive</h1>
    <p>
      Browse the archive by kalam category, or search the complete collection
      together with Basta.
    </p>

    <div class="hero-actions">
      <a class="button" href="/search/">Search the archive</a>
      <a class="button button-secondary" href="/about/">About this project</a>
    </div>
  </section>

  <section class="category-overview" aria-labelledby="categories-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse</p>
        <h2 id="categories-heading">Kalam categories</h2>
      </div>
      <p>{lyrics.length} entries</p>
    </div>

    <div class="category-grid">
      {
        categories.map(([category, entries]) => (
          <a
            class="category-card"
            href={`/categories/${slugifyCategory(category)}/`}
          >
            <strong>{category}</strong>
            <span>{entries.length} {entries.length === 1 ? "entry" : "entries"}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="category-sections">
    {
      categories.map(([category, entries]) => (
        <section
          class="lyrics-section category-section"
          id={slugifyCategory(category)}
          aria-labelledby={`${slugifyCategory(category)}-heading`}
        >
          <div class="section-heading category-section-heading">
            <div>
              <h2 id={`${slugifyCategory(category)}-heading`}>{category}</h2>
              <p>{entries.length} {entries.length === 1 ? "entry" : "entries"}</p>
            </div>
            <a href={`/categories/${slugifyCategory(category)}/`}>View category →</a>
          </div>

          <LyricList lyrics={entries} />
        </section>
      ))
    }
  </div>
</BaseLayout>
