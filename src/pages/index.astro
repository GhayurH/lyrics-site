---
// File role: Archive landing page: direct search, the two collections, and compact browsing by Kalam Type.
import BaseLayout from "../layouts/BaseLayout.astro";
import { groupBastaIndexByKalamType } from "../lib/basta-categories";
import { loadBastaNavigationData } from "../lib/basta-pages";
import { compareKalamTypes, slugifyKalamType } from "../lib/lyrics";
import { loadPublishedLyrics, groupLyricsByKalamType } from "../lib/lyrics-data";
import "../styles/home.css";

const lyrics = await loadPublishedLyrics();
const grouped = groupLyricsByKalamType(lyrics);
const { availablePages } = await loadBastaNavigationData();
const bastaByType = groupBastaIndexByKalamType(new Set(availablePages));
const kalamTypes = [...new Set([...grouped.keys(), ...bastaByType.keys()])].sort(compareKalamTypes);
const bastaEntryCount = [...bastaByType.values()].reduce((total, entries) => total + entries.length, 0);
---

<BaseLayout
  title="Kalam Archive"
  description="Search Urdu and Roman Urdu kalam, browse by Kalam Type, or explore the complete Basta book archive."
>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">A searchable collection of Urdu kalam</p>
    <h1 id="home-title">Kalam Archive</h1>
    <p class="home-lead">
      Find nohas, salams, manqabats and other kalam, or explore the complete Basta book.
    </p>

    <form class="home-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="home-search-query">Search Kalam Archive</label>
      <input
        id="home-search-query"
        type="search"
        name="q"
        placeholder="Search titles, Urdu or Roman Urdu…"
        enterkeyhint="search"
      />
      <button class="button" type="submit">Search</button>
    </form>
    <p class="home-intro-help">Search in Urdu or Roman Urdu, or browse by Kalam Type below.</p>
  </section>

  <section id="home-continue" class="home-continue" aria-labelledby="home-continue-title" hidden>
    <div class="home-continue-heading">
      <div><p class="eyebrow">On this device</p><h2 id="home-continue-title">Continue where you left off</h2></div>
      <a href="/saved/">Your library</a>
    </div>
    <div id="home-continue-links" class="home-continue-links"></div>
  </section>

  <section class="home-collections" aria-label="Explore the collections">
    <a class="home-collection-card home-collection-basta" href="/basta/">
      <div class="home-collection-copy">
        <span class="eyebrow">Complete book archive</span>
        <h2>Basta</h2>
        <p>Read original page scans alongside cleaned Urdu and available Roman Urdu text.</p>
        <span class="home-collection-bottom">
          <span class="home-collection-count">{bastaEntryCount} indexed selections</span>
          <span class="home-collection-action">Explore Basta <span aria-hidden="true">→</span></span>
        </span>
      </div>
      <img
        class="home-basta-preview"
        src="/images/basta/original/000.jpg"
        alt=""
        width="1240"
        height="1754"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a class="home-collection-card home-collection-recite" href="/recite/">
      <span class="eyebrow">For reciters and anjumans</span>
      <h2>Recitation Sets</h2>
      <p>Build an ordered programme of kalams, customize Marsiya stanzas, and share one link with the group.</p>
      <span class="home-collection-bottom"><span class="home-collection-count">Plan a majlis</span><span class="home-collection-action">Create a set →</span></span>
    </a>
  </section>

  <section class="home-types" aria-labelledby="kalam-types-heading">
    <div class="home-types-heading">
      <div>
        <p class="eyebrow">Browse the archive</p>
        <h2 id="kalam-types-heading">Kalam Types</h2>
        <p>Choose a category to see standalone kalams and indexed Basta selections. Category totals combine both; search results count individual pages for Basta.</p>
      </div>
      <a class="home-types-search-link" href="/search/">Advanced search <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-type-grid">
      {
        kalamTypes.map((kalamType) => {
          const entries = grouped.get(kalamType) ?? [];
          const bastaEntries = bastaByType.get(kalamType) ?? [];
          const entryCount = entries.length + bastaEntries.length;
          return (
            <a class="home-type-card" href={`/categories/${slugifyKalamType(kalamType)}/`}>
              <span class="home-type-name">{kalamType}</span>
              <span class="home-type-trailing">
                <span class="home-type-count">{entryCount} {entryCount === 1 ? "entry" : "entries"}</span>
                <span class="home-type-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="home-closing" aria-labelledby="home-closing-heading">
    <div>
      <p class="eyebrow">About the project</p>
      <h2 id="home-closing-heading">Help improve Kalam Archive</h2>
      <p>Found a transcription error, or have a kalam to contribute?</p>
    </div>
    <a href="/about/#contact">Corrections and contact <span aria-hidden="true">→</span></a>
  </section>

  <script>
    import { initHomeContinue } from "../client/home-continue";
    initHomeContinue();
  </script>
</BaseLayout>
