---
// Stable, shareable individual Basta kalam routes are generated only for verified sources.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BastaText from "../../../components/BastaText.astro";
import BastaParallelText from "../../../components/BastaParallelText.astro";
import ReadingControls from "../../../components/ReadingControls.astro";
import { loadBastaKalamCatalog } from "../../../lib/basta-kalam-data";
import type { BastaKalam } from "../../../lib/basta-kalam-units";
import "../../../styles/basta-shell.css";
import "../../../styles/basta-text.css";
import "../../../styles/basta-kalam.css";
import "../../../styles/corrections.css";
import { searchIndexAliases } from "../../../lib/search-normalization";
import { getBastaKalamTypeForSection } from "../../../lib/basta-categories";

export const prerender = true;
export async function getStaticPaths() {
  const { kalams } = await loadBastaKalamCatalog();
  return kalams.filter((item) => item.status === "ready").map((kalam) => ({
    params: { id: kalam.id }, props: { kalam },
  }));
}
const { kalam } = Astro.props as { kalam: BastaKalam };
const page = kalam.startPage;
const pages = [...new Set(kalam.pages)].sort((a, b) => a - b);
const hasRoman = Boolean(kalam.roman?.trim());
const scanUrl = `/images/basta/original/${String(page).padStart(3, "0")}.png`;
const kalamType = getBastaKalamTypeForSection(kalam.sectionRoman);
const sourceScanUrl = (value: number) => `/images/basta/original/${String(value).padStart(3, "0")}.png`;
---
<BaseLayout
  title={`${kalam.romanName || kalam.name} | Basta | Kalam Archive`}
  description={`Read ${kalam.romanName || kalam.name} in Urdu${hasRoman ? " and Roman Urdu" : ""}, with the original Basta page scans.`}
>
  <article class="basta-page basta-kalam-page">
    <div class="pagefind-data" aria-hidden="true">
      <span data-pagefind-filter="collection">Basta</span>
      <span data-pagefind-meta="collection">Basta · Individual kalam</span>
      <span data-pagefind-meta="title">{kalam.romanName || kalam.name}</span>
      {kalam.romanName && <span data-pagefind-meta="roman_title">{kalam.romanName}</span>}
      {kalamType && <span data-pagefind-filter="kalamType">{kalamType}</span>}
      <span data-pagefind-meta="page">{page}</span>
      <span data-pagefind-meta="searchTerms">{kalam.name} {kalam.romanName || ""} {kalam.sectionRoman}</span>
    </div>
    <div class="visually-hidden" aria-hidden="true" data-pagefind-body>
      <p>{searchIndexAliases([kalam.name,kalam.romanName,kalam.urdu,kalam.roman].filter(Boolean).join(" "))}</p>
      {kalam.urdu.split(/\r?\n/u).filter(Boolean).map((verse) => <p lang="ur" dir="rtl">{verse}</p>)}
      {kalam.roman?.split(/\r?\n/u).filter(Boolean).map((verse) => <p lang="en" dir="ltr">{verse}</p>)}
    </div>
    <nav class="basta-subnav" aria-label="Basta navigation" data-pagefind-ignore>
      <a href="/basta/">Basta</a><span aria-hidden="true">/</span>
      <a href="/basta/index/">Index</a><span aria-hidden="true">/</span>
      <a href={`/basta/${page}/`}>Printed page {page}</a>
    </nav>
    <header class="basta-kalam-heading" data-pagefind-ignore>
      <p class="eyebrow">{kalam.sectionRoman} · {kalam.indexNumber}</p>
      <h1 lang="ur" dir="rtl">{kalam.name}</h1>
      {kalam.romanName && <p lang="en" dir="ltr">{kalam.romanName}</p>}
      <p>Source pages:
        {pages.map((p, i) => <><a href={`/basta/${p}/`}>{p}</a>{i < pages.length - 1 ? ", " : ""}</>)}
      </p>
      <div class="basta-kalam-actions">
        <a href={`/recite/?add=${encodeURIComponent("basta:" + kalam.id)}`}>Add to Recitation Set</a>
        <button type="button" data-basta-kalam-favorite data-kalam-id={kalam.id}
          data-kalam-title={kalam.romanName || kalam.name} aria-pressed="false">Save kalam</button>
        <button type="button" data-correction-open data-source-id={kalam.id} data-source-page={String(page)}>
          Suggest a correction
        </button>
      </div>
    </header>
    {kalam.stanzas.length > 0 && <details class="basta-kalam-source-map" data-pagefind-ignore>
      <summary>Source scans for numbered stanzas</summary>
      <ol>
        {kalam.stanzas.map((stanza) => <li data-source-stanza={stanza.printedNumber || String(stanza.number)} data-source-pages={stanza.pages.join(",")}>
          Stanza {stanza.printedNumber || stanza.number}:
          {stanza.pages.map((p) => <>
            <a href={`#scan-page-${p}`}>Locate source page {p}</a>
            <a href={sourceScanUrl(p)} aria-label={`Open full-size source scan page ${p}`}>Full scan</a>
          </>)}
        </li>)}
      </ol>
    </details>}
    <ReadingControls ariaLabel="Basta kalam reader" hasImage showModes={hasRoman} />
    <div
      class:list={["basta-page-grid", hasRoman && "basta-page-grid-with-roman"]}
      data-reading-root
      data-reader-kind="basta-page"
      data-basta-current-page={page}
      data-has-roman={String(hasRoman)}
      data-reading-columns={hasRoman ? "urdu roman" : "urdu"}
      data-reading-mode={hasRoman ? "parallel" : "urdu"}
      data-line-spacing="default"

    >
      <figure class="basta-original-page" data-pagefind-ignore data-synced-scroll-panel>
        <a id={`scan-page-${page}`} href={scanUrl} aria-label={`Enlarge original scan of page ${page}`}>
          <img src={scanUrl} alt={`Original Basta page ${page}`} loading="lazy" width="1240" height="1754" />
        </a>
        {pages.length > 1 && <figcaption>
          <details class="basta-additional-scans">
            <summary>View all {pages.length} original source scans</summary>
            {pages.slice(1).map((p) => <div class="basta-additional-scan">
              <a id={`scan-page-${p}`} href={sourceScanUrl(p)} aria-label={`Enlarge original scan of page ${p}`}>
                <img src={sourceScanUrl(p)} alt={`Original Basta page ${p}`}
                  loading="lazy" decoding="async" width="1240" height="1754" />
              </a>
              <a href={`/basta/${p}/`}>Read original page {p}</a>
            </div>)}
          </details>
        </figcaption>}
      </figure>
      {hasRoman
        ? <BastaParallelText urduText={kalam.urdu} romanText={kalam.roman || ""} variant="page" page={page} />
        : <section class="basta-page-text basta-page-urdu" lang="ur" dir="rtl">
            <BastaText text={kalam.urdu} className="basta-urdu-text" />
          </section>}
    </div>
  </article>
  <script>
    import { initReadingControls } from "../../../client/reader-state";
    import { initVerseFitting } from "../../../client/verse-fitting";
    import { initScanViewer } from "../../../client/scan-viewer";
    import { initCorrectionDialog } from "../../../client/corrections";
    import { initBastaKalamFavorites } from "../../../client/basta-kalam-favorites";
    initReadingControls();
    initVerseFitting();
    initScanViewer();
    initCorrectionDialog();
    initBastaKalamFavorites();
  </script>
</BaseLayout>
