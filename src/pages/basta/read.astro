---
// File role: Full-book Basta reader shell: server-renders the first chunk and linked index, then progressively loads the remaining static chunks near the viewport.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BastaContinuousPage from "../../components/BastaContinuousPage.astro";
import BastaParallelIndex from "../../components/BastaParallelIndex.astro";
import ReadingControls from "../../components/ReadingControls.astro";
import type { BastaIndexEntry } from "../../lib/basta";
import { loadBastaReaderDataset } from "../../lib/basta-reader-data";
import indexEntries from "../../data/basta/index.json";
import "../../styles/basta.css";
import "../../styles/basta-reader.css";
import "../../styles/basta-stream.css";

const entries = indexEntries as BastaIndexEntry[];
const { beforeChunks, afterChunks } = await loadBastaReaderDataset();
const initialChunkId = beforeChunks[0]?.id ?? afterChunks[0]?.id;
---

<BaseLayout
  title="Basta — Continuous reader | Kalam Archive"
  description="Read Basta continuously in parallel Urdu and Roman Urdu, Urdu only, or Roman Urdu only."
>
  <article class="basta-reader">
    <header class="basta-reader-header" data-pagefind-ignore>
      <div class="basta-subnav">
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/index/">Index</a>
      </div>
      <h1>Basta — Continuous reader</h1>
      <p>
        Read the complete text as one continuous edition. Switch between
        parallel Urdu and Roman Urdu, Urdu only, or Roman Urdu only.
      </p>
    </header>

    <ReadingControls
      ariaLabel="Basta reading controls"
      className="basta-reading-controls"
      modeGroupLabel="Basta view"
    />

    <div
      class="basta-reader-flow"
      data-basta-reader-flow
      data-basta-stream
      data-reading-root
      data-has-roman="true"
      data-reading-mode="parallel"
      data-font-size="default"
      data-line-spacing="default"
      data-pagefind-ignore
    >
      {
        beforeChunks.map((chunk) => {
          const loaded = chunk.id === initialChunkId;
          return (
            <section
              class="basta-reader-chunk"
              data-basta-chunk={chunk.id}
              data-chunk-url={`/data/basta-reader/${chunk.id}.json`}
              data-start-page={chunk.startPage}
              data-end-page={chunk.endPage}
              data-chunk-loaded={loaded ? "true" : undefined}
              aria-busy={loaded ? undefined : "true"}
            >
              {loaded
                ? chunk.pages.map((page) => <BastaContinuousPage page={page} />)
                : <p class="basta-reader-chunk-message">Loading pages {chunk.startPage}–{chunk.endPage}…</p>}
            </section>
          );
        })
      }

      <section class="basta-reader-index" id="index">
        <BastaParallelIndex entries={entries} linkMode="continuous" />
        <hr class="basta-reader-page-break" aria-hidden="true" />
      </section>

      {
        afterChunks.map((chunk) => {
          const loaded = chunk.id === initialChunkId;
          return (
            <section
              class="basta-reader-chunk"
              data-basta-chunk={chunk.id}
              data-chunk-url={`/data/basta-reader/${chunk.id}.json`}
              data-start-page={chunk.startPage}
              data-end-page={chunk.endPage}
              data-chunk-loaded={loaded ? "true" : undefined}
              aria-busy={loaded ? undefined : "true"}
            >
              {loaded
                ? chunk.pages.map((page) => <BastaContinuousPage page={page} />)
                : <p class="basta-reader-chunk-message">Loading pages {chunk.startPage}–{chunk.endPage}…</p>}
            </section>
          );
        })
      }
    </div>

    <noscript>
      <p class="basta-reader-noscript">
        The continuous reader progressively loads pages with JavaScript. The
        <a href="/basta/">page-by-page reader</a> works without it.
      </p>
    </noscript>
  </article>

  <script>
    import { initReadingControls } from "../../client/reader-state";
    import { initBastaStreamingReader } from "../../client/basta-stream";
    initReadingControls();
    initBastaStreamingReader();
  </script>
</BaseLayout>
