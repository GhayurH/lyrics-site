---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BastaIndexTable from "../../components/BastaIndexTable.astro";
import indexEntries from "../../data/basta/index.json";
import settings from "../../data/basta/settings.json";

interface BastaIndexEntry {
  section?: string;
  sectionRoman?: string;
  number?: number;
  name: string;
  haal: string;
  page: number;
  romanName?: string;
  romanHaal?: string;
}

const entries = indexEntries as BastaIndexEntry[];
const { romanLyricsStartPage } = settings;

const bookPages = (
  await getCollection("basta", ({ data }) => data.published)
).sort((a, b) => a.data.page - b.data.page);

const romanPages = (
  await getCollection("bastaRoman", ({ data }) => data.published)
).sort((a, b) => a.data.page - b.data.page);

const romanByPage = new Map(
  romanPages.map((entry) => [entry.data.page, entry]),
);

// Roman continuous edition deliberately skips all introductory prose.
// It contains image-only pages 1 and 2, the transliterated index,
// then Roman lyrics from the configured first lyrics page onward.
const openingImages = bookPages.filter(
  (entry) => entry.data.page === 1 || entry.data.page === 2,
);

const lyricPageNumbers = new Set<number>();

for (const entry of romanPages) {
  if (entry.data.page >= romanLyricsStartPage) {
    lyricPageNumbers.add(entry.data.page);
  }
}

// Image-only pages near the end still appear in every edition.
for (const entry of bookPages) {
  if (
    entry.data.imageOnly &&
    entry.data.page >= romanLyricsStartPage
  ) {
    lyricPageNumbers.add(entry.data.page);
  }
}

const romanLyricPages = [...lyricPageNumbers]
  .sort((a, b) => a - b)
  .map((page) => ({
    page,
    bookEntry: bookPages.find((entry) => entry.data.page === page),
    romanEntry: romanByPage.get(page),
  }));
---

<BaseLayout
  title="Basta — Roman Urdu edition | Kalam Archive"
  description="Continuous Roman Urdu lyrics edition of Basta with true book page numbers."
>
  <article class="basta-scroll-edition">
    <header class="basta-scroll-header" data-pagefind-ignore>
      <div class="basta-subnav">
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/urdu/">Urdu text edition</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/index/">Index</a>
      </div>
      <h1>Basta — Roman Urdu edition</h1>
    </header>

    <div
      class="basta-continuous-text basta-continuous-roman"
      lang="en"
      dir="ltr"
      data-pagefind-ignore
    >
      {
        openingImages.map((entry) => (
          <section
            class="basta-scroll-page basta-scroll-page-image-only"
            id={`page-${entry.data.page}`}
          >
            <figure class="basta-scroll-original-image">
              <img
                src={entry.data.originalImage}
                alt={`Original scan of Basta page ${entry.data.page}`}
                loading="lazy"
              />
            </figure>
            <p class="basta-scroll-page-number">
              {entry.data.page}
            </p>
            <hr class="basta-page-break" aria-hidden="true" />
          </section>
        ))
      }

      <section class="basta-scroll-index-block" id="index">
        <BastaIndexTable entries={entries} edition="roman" />
        <hr class="basta-page-break" aria-hidden="true" />
      </section>

      {
        romanLyricPages.length === 0 ? (
          <p class="basta-not-ready">
            Roman Urdu lyrics have not been added yet.
          </p>
        ) : (
          romanLyricPages.map((item, index) => (
            <section
              class:list={[
                "basta-scroll-page",
                item.bookEntry?.data.imageOnly &&
                  "basta-scroll-page-image-only",
              ]}
              id={`page-${item.page}`}
            >
              {
                item.bookEntry?.data.imageOnly ? (
                  <figure class="basta-scroll-original-image">
                    <img
                      src={item.bookEntry.data.originalImage}
                      alt={`Original scan of Basta page ${item.page}`}
                      loading="lazy"
                    />
                  </figure>
                ) : (
                  <div class="basta-scroll-text">
                    {(item.romanEntry?.body ?? "").trim()}
                  </div>
                )
              }

              <p class="basta-scroll-page-number">
                {item.page}
              </p>

              {
                index < romanLyricPages.length - 1 && (
                  <hr class="basta-page-break" aria-hidden="true" />
                )
              }
            </section>
          ))
        )
      }
    </div>
  </article>
</BaseLayout>
