---
// File role: Linked Basta index route: renders the bilingual structured index with reader mode controls and navigation across the physical index-page gap.
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BastaParallelIndex from "../../../components/BastaParallelIndex.astro";
import BastaPager from "../../../components/BastaPager.astro";
import indexEntries from "../../../data/basta/index.json";
import settings from "../../../data/basta/settings.json";
import "../../../styles/basta.css";
import "../../../styles/basta-reader.css";
import "../../../styles/responsive-reading.css";

interface BastaIndexEntry {
  section?: string;
  sectionRoman?: string;
  number?: number;
  name: string;
  haal?: string;
  page: number;
  romanName?: string;
  romanHaal?: string;
}

const entries = indexEntries as BastaIndexEntry[];
const { indexStartPage, indexEndPage } = settings;

const allPages = (
  await getCollection("basta", ({ data }) => data.published)
).sort((a, b) => a.data.page - b.data.page);

const pages = allPages.filter(
  (entry) =>
    entry.data.page < indexStartPage ||
    entry.data.page > indexEndPage,
);

const availablePages = pages.map((entry) => entry.data.page);
const previousPage = pages
  .filter((entry) => entry.data.page < indexStartPage)
  .at(-1)?.data.page;
const nextPage = pages.find(
  (entry) => entry.data.page > indexEndPage,
)?.data.page;
---

<BaseLayout
  title="Basta Index | Kalam Archive"
  description="Complete linked Urdu and Roman Urdu index of Basta."
>
  <article class="basta-index-page basta-index-page-modes">
    <header class="basta-index-header">
      <div class="basta-subnav" data-pagefind-ignore>
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/read/#index">Continuous reader</a>
      </div>
      <h1>Basta Index</h1>
    </header>

    <BastaPager
      previousHref={previousPage ? `/basta/${previousPage}/` : undefined}
      nextHref={nextPage ? `/basta/${nextPage}/` : undefined}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />

    <div
      class="reading-controls basta-reading-controls basta-index-reading-controls"
      data-pagefind-ignore
      aria-label="Index reading controls"
    >
      <div class="reading-control-group reading-view-control">
        <span class="reading-control-label">View</span>
        <div class="segmented-control" role="group" aria-label="Index view">
          <button
            type="button"
            data-basta-index-mode="parallel"
            aria-pressed="true"
          >
            Parallel
          </button>
          <button
            type="button"
            data-basta-index-mode="urdu"
            aria-pressed="false"
          >
            Urdu
          </button>
          <button
            type="button"
            data-basta-index-mode="roman"
            aria-pressed="false"
          >
            Roman
          </button>
        </div>
      </div>

      <label class="reading-control-group">
        <span class="reading-control-label">Text size</span>
        <select id="basta-index-font-size">
          <option value="small">Small</option>
          <option value="default" selected>Default</option>
          <option value="large">Large</option>
          <option value="xlarge">Extra large</option>
        </select>
      </label>

      <label class="reading-control-group">
        <span class="reading-control-label">Line spacing</span>
        <select id="basta-index-line-spacing">
          <option value="compact">Compact</option>
          <option value="default" selected>Default</option>
          <option value="relaxed">Relaxed</option>
        </select>
      </label>
    </div>

    <div
      class="basta-index-mode-shell"
      data-basta-index-shell
      data-reading-mode="parallel"
      data-font-size="default"
      data-line-spacing="default"
    >
      <BastaParallelIndex entries={entries} linkMode="page" />
    </div>

    <BastaPager
      previousHref={previousPage ? `/basta/${previousPage}/` : undefined}
      nextHref={nextPage ? `/basta/${nextPage}/` : undefined}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />
  </article>

  <script>
    const PREFS_KEY = "kalam:reading-prefs";

    const shell =
      document.querySelector<HTMLElement>("[data-basta-index-shell]");
    const fontSelect =
      document.querySelector<HTMLSelectElement>("#basta-index-font-size");
    const spacingSelect =
      document.querySelector<HTMLSelectElement>("#basta-index-line-spacing");
    const modeButtons =
      document.querySelectorAll<HTMLButtonElement>("[data-basta-index-mode]");

    const validModes = new Set(["parallel", "urdu", "roman"]);
    const validFontSizes = new Set(["small", "default", "large", "xlarge"]);
    const validSpacings = new Set(["compact", "default", "relaxed"]);

    let savedPrefs: Record<string, unknown> = {};
    try {
      const parsed = JSON.parse(localStorage.getItem(PREFS_KEY) ?? "{}");
      if (parsed && typeof parsed === "object") {
        savedPrefs = parsed as Record<string, unknown>;
      }
    } catch {}

    const prefs = {
      mode:
        typeof savedPrefs.mode === "string" && validModes.has(savedPrefs.mode)
          ? savedPrefs.mode
          : "parallel",
      fontSize:
        typeof savedPrefs.fontSize === "string" &&
        validFontSizes.has(savedPrefs.fontSize)
          ? savedPrefs.fontSize
          : "default",
      spacing:
        typeof savedPrefs.spacing === "string" &&
        validSpacings.has(savedPrefs.spacing)
          ? savedPrefs.spacing
          : "default",
    };

    function storePrefs() {
      try {
        localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
      } catch {}
    }

    function applyPrefs() {
      if (!shell) return;

      shell.dataset.readingMode = prefs.mode;
      shell.dataset.fontSize = prefs.fontSize;
      shell.dataset.lineSpacing = prefs.spacing;

      if (fontSelect) fontSelect.value = prefs.fontSize;
      if (spacingSelect) spacingSelect.value = prefs.spacing;

      modeButtons.forEach((button) => {
        const active = button.dataset.bastaIndexMode === prefs.mode;
        button.setAttribute("aria-pressed", String(active));
      });
    }

    modeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.bastaIndexMode;
        if (!mode || !validModes.has(mode)) return;
        prefs.mode = mode;
        storePrefs();
        applyPrefs();
      });
    });

    fontSelect?.addEventListener("change", () => {
      if (!validFontSizes.has(fontSelect.value)) return;
      prefs.fontSize = fontSelect.value;
      storePrefs();
      applyPrefs();
    });

    spacingSelect?.addEventListener("change", () => {
      if (!validSpacings.has(spacingSelect.value)) return;
      prefs.spacing = spacingSelect.value;
      storePrefs();
      applyPrefs();
    });

    applyPrefs();
  </script>
</BaseLayout>
