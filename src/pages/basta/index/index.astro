---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import indexEntries from "../../../data/basta/index.json";

interface BastaIndexEntry {
  section: string;
  title: string;
  page: number;
}

const entries = indexEntries as BastaIndexEntry[];
const groups = new Map<string, BastaIndexEntry[]>();

for (const entry of entries) {
  const section = entry.section || "Index";
  if (!groups.has(section)) groups.set(section, []);
  groups.get(section)!.push(entry);
}
---

<BaseLayout
  title="Basta Index | Kalam Archive"
  description="Index of Basta with direct links to the corresponding book pages."
>
  <article class="basta-index-page">
    <header class="basta-index-header">
      <div class="basta-subnav">
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/urdu/">Urdu text edition</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/roman/">Roman edition</a>
      </div>
      <h1>Basta Index</h1>
    </header>

    {
      entries.length === 0 ? (
        <p>The index has not been added yet.</p>
      ) : (
        <div class="basta-index-groups" lang="ur" dir="rtl">
          {
            Array.from(groups.entries()).map(([section, sectionEntries]) => (
              <section class="basta-index-section">
                <h2>{section}</h2>
                <ul class="basta-index-list">
                  {sectionEntries.map((entry) => (
                    <li>
                      <a href={`/basta/${entry.page}/`}>
                        <span class="basta-index-title">{entry.title}</span>
                        <span
                          class="basta-index-page-number"
                          aria-label={`Page ${entry.page}`}
                        >
                          {entry.page}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      )
    }
  </article>
</BaseLayout>
