---
// File role: Linked Basta index route: renders the bilingual structured index with reader mode controls and navigation across the physical index-page gap.
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BastaParallelIndex from "../../../components/BastaParallelIndex.astro";
import BastaPager from "../../../components/BastaPager.astro";
import ReadingControls from "../../../components/ReadingControls.astro";
import type { BastaIndexEntry } from "../../../lib/basta";
import indexEntries from "../../../data/basta/index.json";
import settings from "../../../data/basta/settings.json";
import "../../../styles/basta.css";
import "../../../styles/basta-reader.css";
import "../../../styles/responsive-reading.css";

const entries = indexEntries as BastaIndexEntry[];
const { indexStartPage, indexEndPage } = settings;

const allPages = (
  await getCollection("basta", ({ data }) => data.published)
).sort((a, b) => a.data.page - b.data.page);

const pages = allPages.filter(
  (entry) =>
    entry.data.page < indexStartPage ||
    entry.data.page > indexEndPage,
);

const availablePages = pages.map((entry) => entry.data.page);
const previousPage = pages
  .filter((entry) => entry.data.page < indexStartPage)
  .at(-1)?.data.page;
const nextPage = pages.find(
  (entry) => entry.data.page > indexEndPage,
)?.data.page;
---

<BaseLayout
  title="Basta Index | Kalam Archive"
  description="Complete linked Urdu and Roman Urdu index of Basta."
>
  <article class="basta-index-page basta-index-page-modes">
    <header class="basta-index-header">
      <div class="basta-subnav" data-pagefind-ignore>
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/read/#index">Continuous reader</a>
      </div>
      <h1>Basta Index</h1>
    </header>

    <BastaPager
      previousHref={previousPage ? `/basta/${previousPage}/` : undefined}
      nextHref={nextPage ? `/basta/${nextPage}/` : undefined}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />

    <ReadingControls
      className="basta-reading-controls basta-index-reading-controls"
      ariaLabel="Index reading controls"
      modeGroupLabel="Index view"
    />

    <div
      class="basta-index-mode-shell"
      data-reading-root
      data-has-roman="true"
      data-reading-mode="parallel"
      data-font-size="default"
      data-line-spacing="default"
    >
      <BastaParallelIndex entries={entries} linkMode="page" />
    </div>

    <BastaPager
      previousHref={previousPage ? `/basta/${previousPage}/` : undefined}
      nextHref={nextPage ? `/basta/${nextPage}/` : undefined}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />
  </article>

  <script>
    import { initReadingControls } from "../../../scripts/reader-state.js";
    initReadingControls();
  </script>
</BaseLayout>
