---
// File role: Basta landing route: offers page-by-page, continuous, index, and PDF entry points without loading the full reader payload.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import settings from "../../data/basta/settings.json";
import "../../styles/basta.css";

const { indexStartPage, indexEndPage } = settings;

const pages = (
  await getCollection("basta", ({ data }) => data.published)
)
  .filter(
    (entry) =>
      entry.data.page < indexStartPage ||
      entry.data.page > indexEndPage,
  )
  .sort((a, b) => a.data.page - b.data.page);

const availablePages = pages.map((entry) => entry.data.page);
const firstPage = availablePages[0];
const lastPage = availablePages.at(-1);
---

<BaseLayout
  title="Basta | Kalam Archive"
  description="Read Basta page by page, or in the full-book continuous reader, or download the original PDF."
>
  <article class="basta-home basta-home-redesign">
    <header class="basta-home-header">
      <h1>Basta</h1>
      <p>
        Read the book page by page, or open the complete continuous reader,
        or download the original PDF.
      </p>
    </header>

    <section
      class="basta-home-mode"
      aria-labelledby="page-reader-heading"
    >
      <div class="basta-home-mode-copy">
        <p class="basta-home-kicker">Reader</p>
        <h2 id="page-reader-heading">Page-by-page reader</h2>
        <p>
          Read one book page at a time with the original scan and available
          Urdu and Roman Urdu text.
        </p>
      </div>

      <div class="basta-page-reader-actions">
        {
          firstPage && (
            <a
              class="button basta-home-primary-button"
              href={`/basta/${firstPage}/`}
            >
              Start at page {firstPage}
            </a>
          )
        }

        <a class="button basta-home-secondary-button" href="/basta/index/">
          Open book index
        </a>
      </div>

      {
        firstPage && lastPage && (
          <form
            class="basta-home-page-jump"
            data-basta-home-jump
            aria-label="Go directly to a Basta page"
          >
            <label for="basta-home-page-number">Go to page</label>

            <div class="basta-home-page-jump-controls">
              <input
                id="basta-home-page-number"
                name="page"
                type="number"
                min={firstPage}
                max={lastPage}
                inputmode="numeric"
                placeholder="Page"
                required
              />
              <button type="submit">Open page</button>
            </div>

            <p class="basta-home-page-hint">Enter a book page number.</p>
          </form>
        )
      }
    </section>

    <section class="basta-home-mode" aria-labelledby="continuous-reader-heading">
      <div class="basta-home-mode-copy">
        <p class="basta-home-kicker">Full book</p>
        <h2 id="continuous-reader-heading">Continuous reader</h2>
        <p>
          Read the full book as one continuous flow with Parallel/Stacked,
          Urdu-only, and Roman Urdu-only views.
        </p>
      </div>

      <a class="button basta-home-primary-button" href="/basta/read/">
        Open full-book reader
      </a>
    </section>

    <section class="basta-home-download" aria-labelledby="download-heading">
      <div>
        <h2 id="download-heading">Original PDF</h2>
        <p>Download the complete original Basta as a PDF.</p>
      </div>

      <a
        class="button basta-home-secondary-button"
        href="/files/basta/basta.pdf"
        download
      >
        Download Basta PDF
      </a>
    </section>
  </article>

  <script
    is:inline
    define:vars={{
      availableBastaPages: availablePages,
      bastaIndexStartPage: indexStartPage,
      bastaIndexEndPage: indexEndPage,
    }}
  >
    const jumpForm = document.querySelector("[data-basta-home-jump]");
    const jumpInput = jumpForm?.querySelector('input[name="page"]');

    jumpForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const page = Number(jumpInput?.value);

      if (!Number.isInteger(page)) {
        jumpInput?.setCustomValidity("Enter a valid page number.");
        jumpInput?.reportValidity();
        return;
      }

      if (page >= bastaIndexStartPage && page <= bastaIndexEndPage) {
        window.location.href = "/basta/index/";
        return;
      }

      if (!availableBastaPages.includes(page)) {
        jumpInput?.setCustomValidity("That page is not available.");
        jumpInput?.reportValidity();
        return;
      }

      window.location.href = `/basta/${page}/`;
    });

    jumpInput?.addEventListener("input", () => {
      jumpInput.setCustomValidity("");
    });
  </script>
</BaseLayout>
