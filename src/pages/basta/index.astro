---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import settings from "../../data/basta/settings.json";

const { indexStartPage, indexEndPage } = settings;

const pages = (
  await getCollection("basta", ({ data }) => data.published)
)
  .filter(
    (entry) =>
      entry.data.page < indexStartPage ||
      entry.data.page > indexEndPage,
  )
  .sort((a, b) => a.data.page - b.data.page);

const availablePages = pages.map((entry) => entry.data.page);
const firstPage = availablePages[0];
const lastPage = availablePages.at(-1);
---

<BaseLayout
  title="Basta | Kalam Archive"
  description="Read Basta page by page, or in the full-book continuous reader, or download the original PDF."
>
  <article class="basta-home basta-home-redesign">
    <header class="basta-home-header">
      <h1>Basta</h1>
      <p>
        Read the book page by page, or open the complete continuous reader,
        or download the original PDF.
      </p>
    </header>

    <section
      class="basta-home-mode basta-home-mode-primary"
      aria-labelledby="page-reader-heading"
    >
      <div class="basta-home-mode-copy">
        <p class="basta-home-kicker">Reader</p>
        <h2 id="page-reader-heading">Page-by-page reader</h2>
        <p>
          Read one book page at a time with the original scan and available
          Urdu and Roman Urdu text.
        </p>
      </div>

      <div class="basta-page-reader-actions">
        {
          firstPage && (
            <a
              class="button basta-home-primary-button"
              href={`/basta/${firstPage}/`}
            >
              Start at page {firstPage}
            </a>
          )
        }

        <a
          class="button basta-home-secondary-button"
          href="/basta/index/"
        >
          Open book index
        </a>
      </div>

      {
        firstPage && lastPage && (
          <form
            class="basta-home-page-jump"
            data-basta-home-jump
            aria-label="Go directly to a Basta page"
          >
            <label for="basta-home-page-number">Go to page</label>

            <div class="basta-home-page-jump-controls">
              <input
                id="basta-home-page-number"
                name="page"
                type="number"
                min={firstPage}
                max={lastPage}
                inputmode="numeric"
                placeholder="Page"
                required
              />
              <button type="submit">Open page</button>
            </div>

            <p class="basta-home-page-hint">
              Enter a book page number.
            </p>
          </form>
        )
      }
    </section>

    <section
      class="basta-home-mode"
      aria-labelledby="continuous-reader-heading"
    >
      <div class="basta-home-mode-copy">
        <p class="basta-home-kicker">Full book</p>
        <h2 id="continuous-reader-heading">Continuous reader</h2>
        <p>
          Read the full book as one continuous flow with Parallel/Stacked,
          Urdu-only, and Roman Urdu-only views.
        </p>
      </div>

      <a
        class="button basta-home-primary-button"
        href="/basta/read/"
      >
        Open full-book reader
      </a>
    </section>

    <section
      class="basta-home-download"
      aria-labelledby="download-heading"
    >
      <div>
        <h2 id="download-heading">Original PDF</h2>
        <p>Download the complete original Basta as a PDF.</p>
      </div>

      <a
        class="button basta-home-secondary-button"
        href="/files/basta/basta.pdf"
        download
      >
        Download Basta PDF
      </a>
    </section>
  </article>

  <script
    is:inline
    define:vars={{
      availableBastaPages: availablePages,
      bastaIndexStartPage: indexStartPage,
      bastaIndexEndPage: indexEndPage,
    }}
  >
    const jumpForm = document.querySelector("[data-basta-home-jump]");
    const jumpInput = jumpForm?.querySelector('input[name="page"]');

    jumpForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const page = Number(jumpInput?.value);

      if (!Number.isInteger(page)) {
        jumpInput?.setCustomValidity("Enter a valid page number.");
        jumpInput?.reportValidity();
        return;
      }

      if (
        page >= bastaIndexStartPage &&
        page <= bastaIndexEndPage
      ) {
        window.location.href = "/basta/index/";
        return;
      }

      if (!availableBastaPages.includes(page)) {
        jumpInput?.setCustomValidity("That page is not available.");
        jumpInput?.reportValidity();
        return;
      }

      window.location.href = `/basta/${page}/`;
    });

    jumpInput?.addEventListener("input", () => {
      jumpInput.setCustomValidity("");
    });
  </script>
</BaseLayout>

<style>
  .basta-home-redesign {
    max-width: 52rem;
    padding-bottom: 3rem;
  }

  .basta-home-redesign .basta-home-header {
    margin-bottom: 2.5rem;
  }

  .basta-home-redesign .basta-home-header > p {
    max-width: 42rem;
  }

  .basta-home-mode {
    display: grid;
    gap: 1.35rem;
    margin-top: 1rem;
    border: 1px solid var(--border-colour);
    border-radius: 0.85rem;
    padding: clamp(1.15rem, 3vw, 1.65rem);
    background: var(--surface-background);
  }

  .basta-home-mode + .basta-home-mode {
    margin-top: 1rem;
  }

  .basta-home-mode-primary {
    border-width: 1px;
  }

  .basta-home-mode-copy h2,
  .basta-home-download h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    line-height: 1.2;
  }

  .basta-home-mode-copy > p:last-child,
  .basta-home-download p {
    margin: 0.55rem 0 0;
    color: var(--secondary-text);
  }

  .basta-home-kicker {
    margin: 0 0 0.4rem;
    color: var(--secondary-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .basta-page-reader-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .basta-home-primary-button,
  .basta-home-secondary-button,
  .basta-home-page-jump button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border-radius: 0.55rem;
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }

  .basta-home-primary-button,
  .basta-home-page-jump button {
    border: 1px solid var(--button-background);
    background: var(--button-background);
    color: var(--button-text);
  }

  .basta-home-secondary-button {
    border: 1px solid var(--border-colour);
    background: var(--surface-background);
    color: var(--primary-text);
  }

  .basta-home-secondary-button:hover {
    background: var(--tag-background);
  }

  .basta-home-page-jump {
    display: grid;
    gap: 0.45rem;
    border-top: 1px solid var(--border-colour);
    padding-top: 1.15rem;
  }

  .basta-home-page-jump > label {
    color: var(--secondary-text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .basta-home-page-jump-controls {
    display: flex;
    gap: 0.55rem;
    max-width: 24rem;
  }

  .basta-home-page-jump input {
    min-width: 0;
    flex: 1;
    min-height: 2.75rem;
    border: 1px solid var(--border-colour);
    border-radius: 0.55rem;
    padding: 0.55rem 0.7rem;
    background: var(--site-background);
    color: var(--primary-text);
    font: inherit;
    font-variant-numeric: tabular-nums;
  }

  .basta-home-page-hint {
    margin: 0;
    color: var(--secondary-text);
    font-size: 0.76rem;
  }

  .basta-home-download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border-colour);
    padding-top: 1.5rem;
  }

  @media (max-width: 560px) {
    .basta-page-reader-actions,
    .basta-home-page-jump-controls,
    .basta-home-download {
      align-items: stretch;
      flex-direction: column;
    }

    .basta-home-primary-button,
    .basta-home-secondary-button,
    .basta-home-page-jump button {
      width: 100%;
    }

    .basta-home-page-jump-controls {
      max-width: none;
    }

    .basta-home-download {
      gap: 1rem;
    }
  }
</style>
