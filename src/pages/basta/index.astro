---
// File role: Basta landing: clear reading-mode choices, independent index/page jump, download, and saved reading position.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBastaNavigationData } from "../../lib/basta-pages";
import "../../styles/basta.css";

const { availablePages, indexStartPage, indexEndPage } = await loadBastaNavigationData();
const firstPage = availablePages[0];
const lastPage = availablePages.at(-1);
---

<BaseLayout
  title="Basta | Kalam Archive"
  description="Explore the complete Basta book in page-by-page or continuous reading mode, browse the index, or download the original PDF."
>
  <article class="basta-home basta-home-redesign">
    <header class="basta-home-header">
      <div class="basta-home-intro">
        <div class="basta-home-intro-copy">
          <p class="eyebrow">The complete book archive</p>
          <h1>Basta</h1>
          <p>
            Explore original page scans alongside cleaned Urdu text and Roman Urdu
            where available. Read one page at a time or as a continuous book.
          </p>
          <div class="basta-home-start-actions">
            {firstPage && (
              <a class="button" href={`/basta/${firstPage}/`}>Start at page {firstPage}</a>
            )}
            <a class="button button-secondary" href="/basta/read/">Read continuously</a>
            <a class="basta-home-resume" data-resume-basta href="/basta/" hidden>Continue reading</a>
          </div>
        </div>
        <div class="basta-home-book" aria-hidden="true">
          <span class="basta-home-book-title" lang="ur" dir="rtl">بستہ</span>
          <span class="basta-home-book-subtitle">Digital book archive</span>
        </div>
      </div>
    </header>

    <section class="basta-home-modes" aria-label="Choose a reading mode">
      <div class="basta-home-modes-heading">
        <p class="eyebrow">Reading options</p>
        <h2>Choose how to read</h2>
      </div>
      <div class="basta-home-mode-grid">
        <a class="basta-home-mode-card" href={firstPage ? `/basta/${firstPage}/` : "/basta/index/"}>
          <span class="basta-home-mode-number" aria-hidden="true">01</span>
          <h3>Page by page</h3>
          <p>Move through individual book pages with the original scan and available Urdu and Roman Urdu.</p>
          <span class="basta-home-mode-action">Open page reader <span aria-hidden="true">→</span></span>
        </a>
        <a class="basta-home-mode-card" href="/basta/read/">
          <span class="basta-home-mode-number" aria-hidden="true">02</span>
          <h3>Continuous reader</h3>
          <p>Read the complete book in one flow and choose which text and scan columns to display.</p>
          <span class="basta-home-mode-action">Open continuous reader <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <section class="basta-home-find" aria-labelledby="basta-home-find-heading">
      <div class="basta-home-find-intro">
        <p class="eyebrow">Navigate the book</p>
        <h2 id="basta-home-find-heading">Find a page or kalam</h2>
        <p>Use the book index to find a kalam, or go straight to a numbered page.</p>
        <a class="basta-home-index-link" href="/basta/index/">Browse book index <span aria-hidden="true">→</span></a>
      </div>
      {
        firstPage && lastPage && (
          <form
            class="basta-home-page-jump"
            data-basta-jump-form
            data-available-pages={availablePages.join(",")}
            data-index-start-page={indexStartPage}
            data-index-end-page={indexEndPage}
            aria-label="Go directly to a Basta page"
          >
            <label for="basta-home-page-number">Go to page</label>
            <div class="basta-home-page-jump-controls">
              <input
                id="basta-home-page-number"
                name="page"
                type="number"
                min={firstPage}
                max={lastPage}
                inputmode="numeric"
                placeholder="Page number"
                required
              />
              <button type="submit">Go</button>
            </div>
            <p class="basta-home-page-hint">Enter a page number from the book.</p>
          </form>
        )
      }
    </section>

    <section class="basta-home-download" aria-labelledby="basta-home-pdf-heading">
      <div>
        <h2 id="basta-home-pdf-heading">Original Basta PDF</h2>
        <p>Prefer the source document? Download the complete original book.</p>
      </div>
      <a class="button button-secondary" href="/files/basta/basta.pdf" download>
        Download PDF
      </a>
    </section>
  </article>

  <script>
    import { initBastaPageJumps } from "../../client/basta-navigation";
    import { initResumeBasta } from "../../client/reading-progress";
    initBastaPageJumps();
    initResumeBasta();
  </script>
</BaseLayout>
