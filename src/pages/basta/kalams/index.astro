---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReaderSubnav from "../../../components/ReaderSubnav.astro";
import { loadBastaKalamCatalog } from "../../../lib/basta-kalam-data";
import "../../../styles/basta-kalam.css";
const { kalams } = await loadBastaKalamCatalog();
const groups = new Map<string, typeof kalams>();
for (const kalam of kalams) {
  const group = groups.get(kalam.sectionRoman) || [];
  group.push(kalam);
  groups.set(kalam.sectionRoman, group);
}
---
<BaseLayout title="Individual Basta kalams | Kalam Archive"
  description="Find and share individual kalams from the Basta book, with Urdu, Roman Urdu and source pages.">
  <article class="basta-page basta-kalam-catalog">
    <ReaderSubnav ariaLabel="Basta navigation" items={[
        { label: "Basta", href: "/basta/" },
        { label: "Printed index", href: "/basta/index/" },
      ]} />
    <header class="page-header-simple">
      <h1>Individual Basta kalams</h1>
      <p>Read and share a complete kalam, even when its text spans several printed pages.
      Unverified entries remain linked to their source pages.</p>
    </header>
    {[...groups.entries()].map(([section,entries]) => <section>
      <h2>{section}</h2>
      <ul class="basta-kalam-catalog-list">
        {entries.map((kalam) => <li>
          <a href={kalam.status === "ready" ? `/basta/kalam/${kalam.id}/` : `/basta/${kalam.startPage}/`}
            lang="ur" dir="rtl">{kalam.name}</a>
          {kalam.romanName && <span>{kalam.romanName}</span>}
          <span>Page {kalam.startPage}{kalam.status !== "ready" && " · Source under review"}</span>
        </li>)}
      </ul>
    </section>)}
  </article>
</BaseLayout>
