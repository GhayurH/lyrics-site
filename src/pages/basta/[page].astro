---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import BastaPager from "../../components/BastaPager.astro";
import indexEntries from "../../data/basta/index.json";
import settings from "../../data/basta/settings.json";
import "../../styles/basta.css";
import "../../styles/responsive-reading.css";

interface BastaIndexEntry {
  section?: string;
  sectionRoman?: string;
  number?: number;
  name: string;
  haal?: string;
  page: number;
  romanName?: string;
  romanHaal?: string;
}

const typedIndexEntries = indexEntries as BastaIndexEntry[];
const { indexStartPage, indexEndPage } = settings;

export async function getStaticPaths() {
  // getStaticPaths runs in an isolated scope in Astro.
  // Imports are available, but parent-scope helpers/variables are not,
  // so read the settings inside the function as well.
  const {
    indexStartPage: routeIndexStartPage,
    indexEndPage: routeIndexEndPage,
  } = settings;

  const allPages = (
    await getCollection("basta", ({ data }) => data.published)
  ).sort((a, b) => a.data.page - b.data.page);

  const romanPages = (
    await getCollection("bastaRoman", ({ data }) => data.published)
  ).sort((a, b) => a.data.page - b.data.page);

  const romanByPage = new Map(
    romanPages.map((entry) => [entry.data.page, entry]),
  );

  // The physical index scans are deliberately not separate routes.
  const pages = allPages.filter(
    (entry) =>
      entry.data.page < routeIndexStartPage ||
      entry.data.page > routeIndexEndPage,
  );
  const availablePages = pages.map((entry) => entry.data.page);

  const beforeIndex = pages.filter(
    (entry) => entry.data.page < routeIndexStartPage,
  );
  const afterIndex = pages.filter(
    (entry) => entry.data.page > routeIndexEndPage,
  );

  const lastBeforeIndex = beforeIndex.at(-1)?.data.page;
  const firstAfterIndex = afterIndex[0]?.data.page;

  return pages.map((entry, index) => {
    const page = entry.data.page;

    let previousHref =
      index > 0 ? `/basta/${pages[index - 1].data.page}/` : undefined;
    let nextHref =
      index < pages.length - 1
        ? `/basta/${pages[index + 1].data.page}/`
        : undefined;

    if (page === lastBeforeIndex && firstAfterIndex) {
      nextHref = "/basta/index/";
    }

    if (page === firstAfterIndex && lastBeforeIndex) {
      previousHref = "/basta/index/";
    }

    return {
      params: { page: String(page) },
      props: {
        entry,
        romanEntry: romanByPage.get(page),
        previousHref,
        nextHref,
        availablePages,
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<"basta">;
  romanEntry?: CollectionEntry<"bastaRoman">;
  previousHref?: string;
  nextHref?: string;
  availablePages: number[];
}

const {
  entry,
  romanEntry,
  previousHref,
  nextHref,
  availablePages,
} = Astro.props as Props;

const page = entry.data.page;
const urduText = (entry.body ?? "").trim();
const romanText = (romanEntry?.body ?? "").trim();
const hasRomanText = romanText.length > 0;

const pageIndexEntries = typedIndexEntries.filter(
  (indexEntry) => indexEntry.page === page,
);
const bastaIndexSearchTerms = pageIndexEntries
  .flatMap((indexEntry) => [
    indexEntry.name,
    indexEntry.romanName,
    indexEntry.haal,
    indexEntry.romanHaal,
    indexEntry.section,
    indexEntry.sectionRoman,
  ])
  .filter(Boolean)
  .join(" ");
const haalFilters = [
  ...new Set(
    pageIndexEntries
      .map((indexEntry) => indexEntry.romanHaal || indexEntry.haal || "")
      .filter(Boolean),
  ),
];
---

<BaseLayout
  title={`Basta — page ${page} | Kalam Archive`}
  description={
    entry.data.imageOnly
      ? `Original scan of Basta page ${page}.`
      : hasRomanText
        ? `Basta page ${page}: original scan, cleaned Urdu text, and Roman Urdu transliteration.`
        : `Basta page ${page}: original scan and cleaned Urdu text.`
  }
>
  <article
    class:list={[
      "basta-page",
      hasRomanText && "basta-page-with-roman",
    ]}
    data-pagefind-body
  >
    <header class="basta-page-header">
      <div class="basta-subnav" data-pagefind-ignore>
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href={`/basta/read/#page-${page}`}>Continuous reader</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/index/">Index</a>
      </div>

      <h1 data-pagefind-meta="title">Basta — Page {page}</h1>

      <div class="pagefind-data" aria-hidden="true">
        <span data-pagefind-filter="collection">Basta</span>
        <span data-pagefind-meta="page">{page}</span>
        {bastaIndexSearchTerms && (
          <span data-pagefind-meta="searchTerms">{bastaIndexSearchTerms}</span>
        )}
        {haalFilters.map((haal) => (
          <span data-pagefind-filter="haal">{haal}</span>
        ))}
      </div>
    </header>

    <BastaPager
      currentPage={page}
      previousHref={previousHref}
      nextHref={nextHref}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />

    {
      !entry.data.imageOnly && (
        <div
          class="reading-controls basta-page-reading-controls"
          data-pagefind-ignore
          aria-label="Page reading controls"
        >
          {
            hasRomanText && (
              <div class="reading-control-group reading-view-control">
                <span class="reading-control-label">View</span>
                <div
                  class="segmented-control"
                  role="group"
                  aria-label={`Basta page ${page} view`}
                >
                  <button
                    type="button"
                    data-basta-page-mode="parallel"
                    aria-pressed="true"
                  >
                    Parallel
                  </button>
                  <button
                    type="button"
                    data-basta-page-mode="urdu"
                    aria-pressed="false"
                  >
                    Urdu
                  </button>
                  <button
                    type="button"
                    data-basta-page-mode="roman"
                    aria-pressed="false"
                  >
                    Roman
                  </button>
                </div>
              </div>
            )
          }

          <label class="reading-control-group">
            <span class="reading-control-label">Text size</span>
            <select id="basta-page-font-size">
              <option value="small">Small</option>
              <option value="default" selected>Default</option>
              <option value="large">Large</option>
              <option value="xlarge">Extra large</option>
            </select>
          </label>

          <label class="reading-control-group">
            <span class="reading-control-label">Line spacing</span>
            <select id="basta-page-line-spacing">
              <option value="compact">Compact</option>
              <option value="default" selected>Default</option>
              <option value="relaxed">Relaxed</option>
            </select>
          </label>
        </div>
      )
    }

    <div
      class:list={[
        "basta-page-grid",
        entry.data.imageOnly && "basta-page-grid-image-only",
        hasRomanText && "basta-page-grid-with-roman",
      ]}
      data-basta-page-reading={!entry.data.imageOnly ? "" : undefined}
      data-reading-mode={hasRomanText ? "parallel" : "urdu"}
      data-font-size="default"
      data-line-spacing="default"
    >
      <figure class="basta-original-page" data-pagefind-ignore>
        <figcaption>Original book page</figcaption>
        <a href={entry.data.originalImage}>
          <img
            src={entry.data.originalImage}
            alt={`Original scan of Basta page ${page}`}
            loading="eager"
          />
        </a>
      </figure>

      {
        !entry.data.imageOnly && (
          <section
            class="basta-page-text basta-page-urdu"
            lang="ur"
            dir="rtl"
            aria-label={`Urdu text of Basta page ${page}`}
          >
            <h2 class="basta-page-text-heading">Urdu text</h2>
            <div class="basta-urdu-text">{urduText}</div>
          </section>
        )
      }

      {
        !entry.data.imageOnly && hasRomanText && (
          <section
            class="basta-page-text basta-page-roman"
            lang="en"
            dir="ltr"
            aria-label={`Roman Urdu text of Basta page ${page}`}
          >
            <h2 class="basta-page-text-heading">Roman Urdu</h2>
            <div class="basta-roman-text">{romanText}</div>
          </section>
        )
      }
    </div>

    <BastaPager
      currentPage={page}
      previousHref={previousHref}
      nextHref={nextHref}
      availablePages={availablePages}
      indexStartPage={indexStartPage}
      indexEndPage={indexEndPage}
    />
  </article>

  <script define:vars={{ hasRomanText }}>
    const PREFS_KEY = "kalam:reading-prefs";

    const readingGrid =
      document.querySelector("[data-basta-page-reading]");
    const fontSelect =
      document.querySelector("#basta-page-font-size");
    const spacingSelect =
      document.querySelector("#basta-page-line-spacing");
    const modeButtons =
      document.querySelectorAll("[data-basta-page-mode]");

    const validModes = new Set(["parallel", "urdu", "roman"]);
    const validFontSizes = new Set([
      "small",
      "default",
      "large",
      "xlarge",
    ]);
    const validSpacings = new Set([
      "compact",
      "default",
      "relaxed",
    ]);

    let savedPrefs = {};
    try {
      const parsed = JSON.parse(
        localStorage.getItem(PREFS_KEY) ?? "{}",
      );
      if (parsed && typeof parsed === "object") {
        savedPrefs = parsed;
      }
    } catch {}

    const prefs = {
      mode:
        hasRomanText &&
        typeof savedPrefs.mode === "string" &&
        validModes.has(savedPrefs.mode)
          ? savedPrefs.mode
          : hasRomanText
            ? "parallel"
            : "urdu",
      fontSize:
        typeof savedPrefs.fontSize === "string" &&
        validFontSizes.has(savedPrefs.fontSize)
          ? savedPrefs.fontSize
          : "default",
      spacing:
        typeof savedPrefs.spacing === "string" &&
        validSpacings.has(savedPrefs.spacing)
          ? savedPrefs.spacing
          : "default",
    };

    function storePrefs() {
      try {
        localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
      } catch {}
    }

    function applyPrefs() {
      if (!readingGrid) return;

      readingGrid.dataset.readingMode =
        hasRomanText ? prefs.mode : "urdu";
      readingGrid.dataset.fontSize = prefs.fontSize;
      readingGrid.dataset.lineSpacing = prefs.spacing;

      if (fontSelect) fontSelect.value = prefs.fontSize;
      if (spacingSelect) spacingSelect.value = prefs.spacing;

      modeButtons.forEach((button) => {
        const active =
          button.dataset.bastaPageMode === prefs.mode;
        button.setAttribute("aria-pressed", String(active));
      });
    }

    modeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.bastaPageMode;
        if (!hasRomanText || !mode || !validModes.has(mode)) return;

        prefs.mode = mode;
        storePrefs();
        applyPrefs();
      });
    });

    fontSelect?.addEventListener("change", () => {
      if (!validFontSizes.has(fontSelect.value)) return;

      prefs.fontSize = fontSelect.value;
      storePrefs();
      applyPrefs();
    });

    spacingSelect?.addEventListener("change", () => {
      if (!validSpacings.has(spacingSelect.value)) return;

      prefs.spacing = spacingSelect.value;
      storePrefs();
      applyPrefs();
    });

    applyPrefs();
  </script>
</BaseLayout>

<style>
  .basta-page.basta-page-with-roman {
    max-width: 96rem;
  }

  .basta-page-text-heading {
    margin: 0 0 0.85rem;
    border-bottom: 1px solid var(--border-colour);
    padding-bottom: 0.65rem;
    color: var(--secondary-text);
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .basta-page-urdu .basta-page-text-heading {
    text-align: right;
  }

  .basta-page-roman .basta-page-text-heading {
    text-align: left;
  }

  .basta-roman-text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    unicode-bidi: plaintext;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    text-align: left;
  }
</style>
