---
// File role: Basta page route: combines the original scan with available Urdu/Roman text, page metadata, navigation, and shared reader controls for one printed page.
import type { CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import BastaPager from "../../components/BastaPager.astro";
import BastaParallelText from "../../components/BastaParallelText.astro";
import BastaText from "../../components/BastaText.astro";
import ReadingControls from "../../components/ReadingControls.astro";
import type { BastaIndexEntry } from "../../lib/basta";
import { getBastaKalamTypesForPage, getBastaStanzaStyleForPage } from "../../lib/basta-categories";
import { loadBastaNavigationData, loadBastaRomanByPage } from "../../lib/basta-pages";
import indexEntries from "../../data/basta/index.json";
import settings from "../../data/basta/settings.json";
import "../../styles/basta.css";

const typedIndexEntries = indexEntries as BastaIndexEntry[];
const { indexStartPage, indexEndPage } = settings;

export async function getStaticPaths() {
  const {
    pages,
    availablePages,
    lastBeforeIndex,
    firstAfterIndex,
  } = await loadBastaNavigationData();
  const romanByPage = await loadBastaRomanByPage();

  return pages.map((entry, index) => {
    const page = entry.data.page;
    let previousHref =
      index > 0 ? `/basta/${pages[index - 1].data.page}/` : undefined;
    let nextHref =
      index < pages.length - 1
        ? `/basta/${pages[index + 1].data.page}/`
        : undefined;

    // The linked index occupies the navigation position of the omitted scans.
    if (page === lastBeforeIndex && firstAfterIndex) nextHref = "/basta/index/";
    if (page === firstAfterIndex && lastBeforeIndex) previousHref = "/basta/index/";

    return {
      params: { page: String(page) },
      props: {
        entry,
        romanEntry: romanByPage.get(page),
        previousHref,
        nextHref,
        availablePages,
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<"basta">;
  romanEntry?: CollectionEntry<"bastaRoman">;
  previousHref?: string;
  nextHref?: string;
  availablePages: number[];
}

const {
  entry,
  romanEntry,
  previousHref,
  nextHref,
  availablePages,
} = Astro.props as Props;

const page = entry.data.page;
const stanzaStyle = getBastaStanzaStyleForPage(page);
const urduText = (entry.body ?? "").trim();
const romanText = (romanEntry?.body ?? "").trim();
const hasRomanText = romanText.length > 0;

const pageIndexEntries = typedIndexEntries.filter(
  (indexEntry) => indexEntry.page === page,
);
const bastaIndexSearchTerms = pageIndexEntries
  .flatMap((indexEntry) => [
    indexEntry.name,
    indexEntry.romanName,
    indexEntry.haal,
    indexEntry.romanHaal,
    indexEntry.section,
    indexEntry.sectionRoman,
  ])
  .filter(Boolean)
  .join(" ");
const haalFilters = [
  ...new Set(
    pageIndexEntries
      .map((indexEntry) => indexEntry.romanHaal || indexEntry.haal || "")
      .filter(Boolean),
  ),
];
// Search facets use the same Basta taxonomy as homepage/category browsing,
// including long poems continuing beyond their index entry's starting page.
const kalamTypeFilters = entry.data.imageOnly ? [] : getBastaKalamTypesForPage(page);
---

<BaseLayout
  title={`Basta — page ${page} | Kalam Archive`}
  description={
    entry.data.imageOnly
      ? `Original scan of Basta page ${page}.`
      : hasRomanText
        ? `Basta page ${page}: original scan, cleaned Urdu text, and Roman Urdu transliteration.`
        : `Basta page ${page}: original scan and cleaned Urdu text.`
  }
>
  <article
    class:list={[
      "basta-page",
      hasRomanText && "basta-page-with-roman",
    ]}
    data-pagefind-body
  >
    <header class="basta-page-header">
      <div class="basta-subnav" data-pagefind-ignore>
        <a href="/basta/">Basta</a>
        <span aria-hidden="true">·</span>
        <a href={`/basta/read/#page-${page}`}>Continuous reader</a>
        <span aria-hidden="true">·</span>
        <a href="/basta/index/">Index</a>
        <span aria-hidden="true">·</span>
        <a href={entry.data.originalImage}>Original scan</a>
      </div>

      <h1 data-pagefind-meta="title">Basta — Page {page}</h1>

      <div class="pagefind-data" aria-hidden="true">
        <span data-pagefind-filter="collection">Basta</span>
        {kalamTypeFilters.map((kalamType) => (
          <span data-pagefind-filter="kalamType">{kalamType}</span>
        ))}
        <span data-pagefind-meta="page">{page}</span>
        {bastaIndexSearchTerms && (
          <span data-pagefind-meta="searchTerms">{bastaIndexSearchTerms}</span>
        )}
        {haalFilters.map((haal) => (
          <span data-pagefind-filter="haal">{haal}</span>
        ))}
      </div>
    </header>


    <ReadingControls
      className="basta-page-reading-controls"
      ariaLabel="Page reading controls"
      modeGroupLabel={`Basta page ${page} view`}
      showModes={hasRomanText}
      hasImage
      imageOnly={entry.data.imageOnly}
      bookmarkPage
    >
      <BastaPager slot="navigation"
            currentPage={page}
            previousHref={previousHref}
            nextHref={nextHref}
            availablePages={availablePages}
            indexStartPage={indexStartPage}
            indexEndPage={indexEndPage}
          />
    </ReadingControls>

    <div
      class:list={[
        "basta-page-grid",
        entry.data.imageOnly && "basta-page-grid-image-only",
        hasRomanText && "basta-page-grid-with-roman",
      ]}
      data-reading-root
      data-reader-kind="basta-page"
      data-has-roman={String(hasRomanText)}
      data-image-only={String(entry.data.imageOnly)}
      data-reading-mode={entry.data.imageOnly ? "image" : hasRomanText ? "parallel" : "urdu"}
      data-reading-columns={entry.data.imageOnly ? "image" : hasRomanText ? "urdu roman" : "urdu"}
      data-basta-current-page={page}
      data-line-spacing="default"
      data-synced-scroll-root={!entry.data.imageOnly ? "" : undefined}
    >
      <figure class="basta-original-page" data-pagefind-ignore data-synced-scroll-panel>
        <a href={entry.data.originalImage}>
          <img
            src={entry.data.originalImage}
            alt={`Original scan of Basta page ${page}`}
            loading="eager"
            decoding="async"
          />
        </a>
      </figure>

      {
        !entry.data.imageOnly && hasRomanText && (
          <BastaParallelText
            urduText={urduText}
            romanText={romanText}
            variant="page"
            stanzaStyle={stanzaStyle}
            page={page}
          />
        )
      }

      {
        !entry.data.imageOnly && !hasRomanText && (
          <section
            class="basta-page-text basta-page-urdu"
            lang="ur"
            dir="rtl"
            aria-label={`Urdu text of Basta page ${page}`}
          >
            <BastaText text={urduText} className="basta-urdu-text" indentStanzas={page >= settings.romanLyricsStartPage} stanzaStyle={stanzaStyle} />
          </section>
        )
      }
    </div>

  </article>

  <script>
    import { initReadingControls } from "../../client/reader-state";
    import { initSyncedColumns } from "../../client/synced-columns";
    import { initVerseFitting } from "../../client/verse-fitting";
    import { initScanViewer } from "../../client/scan-viewer";
    import { initReadingProgress } from "../../client/reading-progress";
    initReadingControls();
    initVerseFitting();
    initScanViewer();
    initReadingProgress();
    initSyncedColumns();
  </script>
</BaseLayout>
