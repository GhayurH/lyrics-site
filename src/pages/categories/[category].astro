---
// File role: Kalam Type browse route: combines published standalone lyrics with read-only Basta index entries.
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LyricList from "../../components/LyricList.astro";
import BastaCategoryList from "../../components/BastaCategoryList.astro";
import type { BastaCategoryEntry } from "../../lib/basta-categories";
import { groupBastaIndexByKalamType } from "../../lib/basta-categories";
import { loadBastaNavigationData } from "../../lib/basta-pages";
import { slugifyKalamType } from "../../lib/lyrics";
import { loadPublishedLyrics, groupLyricsByKalamType } from "../../lib/lyrics-data";

export async function getStaticPaths() {
  const standalone = groupLyricsByKalamType(await loadPublishedLyrics());
  const { availablePages } = await loadBastaNavigationData();
  const basta = groupBastaIndexByKalamType(new Set(availablePages));

  const types = new Set([...standalone.keys(), ...basta.keys()]);
  return [...types].map((kalamType) => ({
    params: { category: slugifyKalamType(kalamType) },
    props: {
      kalamType,
      lyrics: standalone.get(kalamType) ?? [],
      bastaEntries: basta.get(kalamType) ?? [],
    },
  }));
}

interface Props {
  kalamType: string;
  lyrics: CollectionEntry<"lyrics">[];
  bastaEntries: BastaCategoryEntry[];
}

const { kalamType, lyrics, bastaEntries } = Astro.props as Props;
const count = lyrics.length + bastaEntries.length;
---

<BaseLayout
  title={`${kalamType} | Kalam Archive`}
  description={`Browse ${kalamType} in the Kalam Archive, including Basta.`}
>
  <section class="category-page">
    <header class="page-header-simple">
      <a class="back-link" href="/">← All Kalam Types</a>
      <p class="eyebrow">Kalam Type</p>
      <h1>{kalamType}</h1>
      <p>{count} {count === 1 ? "entry" : "entries"}</p>
    </header>

    {lyrics.length > 0 && (
      <section aria-labelledby="standalone-kalams-heading">
        <h2 id="standalone-kalams-heading">Standalone kalams</h2>
        <LyricList lyrics={lyrics} />
      </section>
    )}

    {bastaEntries.length > 0 && (
      <section aria-labelledby="basta-kalams-heading">
        <h2 id="basta-kalams-heading">From Basta ({bastaEntries.length})</h2>
        <p>Entries from the printed Basta index. Each link opens its original book page.</p>
        <BastaCategoryList entries={bastaEntries} />
      </section>
    )}
  </section>
</BaseLayout>
