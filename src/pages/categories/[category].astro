---
import CategoryPage from "../../components/CategoryPage.astro";
import { loadCategories, type CategoryData } from "../../lib/category-data";
export async function getStaticPaths() {
  return (await loadCategories()).map((category) => ({
    params: { category: category.slug }, props: { category },
  }));
}
interface Props { category: CategoryData }
const { category } = Astro.props;
---
<CategoryPage category={category} />
