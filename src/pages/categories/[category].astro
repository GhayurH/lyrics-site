---
// File role: Kalam Type archive route: builds one static browse page per canonical type and renders its published lyrics using the shared card system.
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LyricList from "../../components/LyricList.astro";
import {
  slugifyKalamType,
} from "../../lib/lyrics";
import { loadPublishedLyrics, groupLyricsByKalamType } from "../../lib/lyrics-data";

export async function getStaticPaths() {
  const grouped = groupLyricsByKalamType(await loadPublishedLyrics());
  return [...grouped.entries()].map(([kalamType, lyrics]) => ({
    params: { category: slugifyKalamType(kalamType) },
    props: { kalamType, lyrics },
  }));
}

interface Props {
  kalamType: string;
  lyrics: CollectionEntry<"lyrics">[];
}

const { kalamType, lyrics } = Astro.props as Props;
---

<BaseLayout
  title={`${kalamType} | Kalam Archive`}
  description={`Browse ${kalamType} in the Kalam Archive.`}
>
  <section class="category-page">
    <header class="page-header-simple">
      <a class="back-link" href="/">← All Kalam Types</a>
      <p class="eyebrow">Kalam Type</p>
      <h1>{kalamType}</h1>
      <p>{lyrics.length} {lyrics.length === 1 ? "entry" : "entries"}</p>
    </header>
    <LyricList lyrics={lyrics} />
  </section>
</BaseLayout>
