---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LyricList from "../../components/LyricList.astro";
import {
  compareLyrics,
  getLyricCategory,
  slugifyCategory,
} from "../../lib/lyrics";

export async function getStaticPaths() {
  const lyrics = (
    await getCollection("lyrics", ({ data }) => data.published)
  ).sort(compareLyrics);

  const categories = new Map<
    string,
    { category: string; lyrics: CollectionEntry<"lyrics">[] }
  >();

  for (const lyric of lyrics) {
    const category = getLyricCategory(lyric.data);
    const slug = slugifyCategory(category);
    const existing = categories.get(slug) ?? { category, lyrics: [] };
    existing.lyrics.push(lyric);
    categories.set(slug, existing);
  }

  return [...categories.entries()].map(([slug, value]) => ({
    params: { category: slug },
    props: value,
  }));
}

interface Props {
  category: string;
  lyrics: CollectionEntry<"lyrics">[];
}

const { category, lyrics } = Astro.props as Props;
---

<BaseLayout
  title={`${category} | Kalam Archive`}
  description={`Browse ${category} in the Kalam Archive.`}
>
  <section class="category-page">
    <header class="page-header-simple">
      <a class="back-link" href="/">← All categories</a>
      <p class="eyebrow">Kalam category</p>
      <h1>{category}</h1>
      <p>{lyrics.length} {lyrics.length === 1 ? "entry" : "entries"}</p>
    </header>

    <LyricList lyrics={lyrics} />
  </section>
</BaseLayout>
