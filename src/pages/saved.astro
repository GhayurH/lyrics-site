---
// File role: Saved/Recent route shell. The catalog and cards are loaded only on this page by the shared Saved controller.
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/saved.css";
---

<BaseLayout
  title="Saved & recent | Kalam Archive"
  description="Your locally saved and recently viewed Kalam Archive lyrics."
>
  <section id="saved-library" class="saved-page" data-pagefind-ignore="all">
    <header class="page-header-simple">
      <p class="eyebrow">On this device</p>
      <h1>Saved &amp; recent</h1>
      <p>
        Favorites and reading history are stored only in this browser. No
        account or server-side tracking is required.
      </p>
    </header>

    <p data-requires-js class="saved-empty">Saved and recent lyrics require JavaScript because they are stored locally in your browser. You can still <a href="/">browse the archive</a>.</p>

    <p id="saved-load-error" class="saved-empty" hidden>
      The lyric catalog could not be loaded. Reload this page and try again.
    </p>

    <section class="saved-section" aria-labelledby="favorites-heading">
      <div class="section-heading saved-section-heading">
        <div>
          <h2 id="favorites-heading">Saved lyrics</h2>
          <p id="favorites-count">0 saved</p>
        </div>
        <button id="clear-favorites" class="text-button" type="button">
          Clear saved
        </button>
      </div>
      <p id="favorites-empty" class="saved-empty">
        Nothing saved yet. Use the bookmark icon on any kalam card, or <a href="/">browse the archive</a>.
      </p>
      <ul id="favorites-list" class="lyric-list saved-lyric-list" aria-live="polite"></ul>
    </section>

    <section class="saved-section" aria-labelledby="continue-basta-heading" data-basta-resume-section hidden>
      <div class="section-heading"><h2 id="continue-basta-heading">Continue reading</h2></div>
      <p><a data-resume-basta href="/basta/" hidden>Continue Basta</a></p>
    </section>

    <section class="saved-section" aria-labelledby="basta-bookmarks-heading">
      <div class="section-heading saved-section-heading">
        <div><h2 id="basta-bookmarks-heading">Bookmarked Basta pages</h2><p id="basta-bookmarks-count">0 saved</p></div>
      </div>
      <p id="basta-bookmarks-empty" class="saved-empty">No Basta pages bookmarked yet. Use Save page while reading.</p>
      <ul id="basta-bookmarks-list" class="saved-local-list" aria-live="polite"></ul>
    </section>

    <section class="saved-section" aria-labelledby="recitation-drafts-heading">
      <div class="section-heading saved-section-heading">
        <div><h2 id="recitation-drafts-heading">Your recitation programmes</h2><p id="recitation-drafts-count">0 saved</p></div>
      </div>
      <p id="recitation-drafts-empty" class="saved-empty">No programmes yet. <a href="/recite/">Create a recitation set</a>.</p>
      <ul id="recitation-drafts-list" class="saved-local-list"></ul>
    </section>

    <section class="saved-section" aria-labelledby="recent-heading">
      <div class="section-heading saved-section-heading">
        <div>
          <h2 id="recent-heading">Recently viewed</h2>
          <p id="recent-count">0 recent</p>
        </div>
        <button id="clear-recent" class="text-button" type="button">
          Clear history
        </button>
      </div>
      <p id="recent-empty" class="saved-empty">No recently viewed lyrics yet.</p>
      <ul id="recent-list" class="lyric-list saved-lyric-list" aria-live="polite"></ul>
    </section>
  </section>

  <script>
    import { initSavedLibrary } from "../client/saved-library";
    import { initResumeBasta } from "../client/reading-progress";
    void initSavedLibrary();
    initResumeBasta();
  </script>
</BaseLayout>
