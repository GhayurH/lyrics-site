---
// File role: Individual lyric route: builds previous/next navigation within a Kalam Type, renders Urdu/Roman reading modes, and records reader preferences/history.
import {
  type CollectionEntry,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ReadingControls from "../../components/ReadingControls.astro";
import LyricVerses from "../../components/LyricVerses.astro";
import LyricHeader from "../../components/LyricHeader.astro";
import LyricSearchIndex from "../../components/LyricSearchIndex.astro";
import { loadPublishedLyrics, groupLyricsByKalamType } from "../../lib/lyrics-data";
import "../../styles/lyrics.css";
import "../../styles/corrections.css";
import { getLyricKalamType, slugifyKalamType, searchUrl } from "../../lib/lyrics";

export async function getStaticPaths() {
  const byCategory = groupLyricsByKalamType(await loadPublishedLyrics());

  return [...byCategory.entries()].flatMap(([, categoryLyrics]) =>
    categoryLyrics.map((lyric, index) => ({
      params: { id: lyric.id },
      props: {
        lyric,
        previousLyric: index > 0 ? categoryLyrics[index - 1] : undefined,
        nextLyric:
          index < categoryLyrics.length - 1
            ? categoryLyrics[index + 1]
            : undefined,
        categoryCount: categoryLyrics.length,
      },
    })),
  );
}

interface Props {
  lyric: CollectionEntry<"lyrics">;
  previousLyric?: CollectionEntry<"lyrics">;
  nextLyric?: CollectionEntry<"lyrics">;
  categoryCount: number;
}

const {
  lyric,
  previousLyric,
  nextLyric,
  categoryCount,
} = Astro.props as Props;
const { data } = lyric;
const category = getLyricKalamType(data);
function neighborTitle(entry: CollectionEntry<"lyrics">) {
  return entry.data.alternateTitle ?? entry.data.title;
}
---

<BaseLayout
  title={`${data.title} | Kalam Archive`}
  description={`Read ${data.title} in Urdu${data.romanLyrics ? " and Roman Urdu" : ""}.`}
>
  <article
    class="lyric-page"
    data-reader-shell
    data-lyric-id={lyric.id}
  >
    <LyricHeader lyric={lyric} />

    <LyricSearchIndex lyric={lyric} />

    <ReadingControls
      ariaLabel="Reading controls"
      modeGroupLabel="Lyric view"
      showModes={Boolean(data.romanLyrics)}
      hasImage={Boolean(data.cover)}
    />

    <div
      class="lyric-reading-grid"
      data-reading-root
      data-reader-kind="lyrics"
      data-has-roman={String(Boolean(data.romanLyrics))}
      data-reading-mode={data.romanLyrics ? "parallel" : "urdu"}
      data-reading-columns={data.romanLyrics ? "urdu roman" : "urdu"}
      data-line-spacing="default"

    >
      {data.cover && (
        <figure class="lyric-reading-image" data-synced-scroll-panel aria-label="Original lyric sheet">
          <a class="scan-viewer-trigger" href={data.cover} aria-label="Enlarge original lyric sheet">
            <img src={data.cover} alt={data.coverAlt || "Original lyric sheet"} data-pagefind-meta="image[src], image_alt[alt]" loading="lazy" decoding="async" />
          </a>
        </figure>
      )}
      <section
        class="lyric-reading-panel lyric-reading-urdu"

        dir={data.direction}
        lang={data.lang}
        aria-label={`${data.language} lyrics`}
      >
        <h2 class="lyric-version-heading">
          <span class="lyric-focus-title kalam-reading-title" lang={data.lang} dir={data.direction}>{data.title}</span>
        </h2>
        <LyricVerses text={lyric.body ?? ""} className="lyrics-text" sixVerseLayout={data.sixVerseLayout} />
      </section>

      {
        data.romanLyrics && (
          <section
            class="lyric-reading-panel lyric-reading-roman"

            lang="en"
            dir="ltr"
            aria-label="Roman Urdu lyrics"
          >
            <h2 class="lyric-version-heading">
              <span class="lyric-focus-title kalam-reading-title" lang={data.alternateTitle ? "en" : data.lang} dir={data.alternateTitle ? "ltr" : data.direction}>
                {data.alternateTitle ?? data.title}
              </span>
            </h2>
            <LyricVerses text={data.romanLyrics} className="roman-lyrics-text" sixVerseLayout={data.sixVerseLayout} />
          </section>
        )
      }
    </div>

    {
      data.bastaPage && data.bastaNote && (
        <aside class="lyric-basta-note" aria-label="Basta edition" data-pagefind-ignore>
          {data.bastaNote === "original-selection"
            ? "For the original selection, see "
            : "For additional stanzas, see "}
          <a href={`/basta/${data.bastaPage}/`}>
            <cite>Basta</cite>, p. {data.bastaPage}
          </a>.
        </aside>
      )
    }

    {
      data.tags.length > 0 && (
        <footer class="tag-list" data-pagefind-ignore>
          <span class="tag-list-label">Tags</span>
          {data.tags.map((tag) => (
            <a
              class="tag-link"
              href={searchUrl({ collection: "Lyrics", tag })}
            >
              {tag}
            </a>
          ))}
        </footer>
      )
    }

    <nav class="lyric-neighbor-nav" aria-label={`${category} lyric navigation`} data-pagefind-ignore>
      <div class="lyric-neighbor-slot lyric-neighbor-previous">
        {
          previousLyric && (
            <a href={`/lyrics/${previousLyric.id}/`}>
              <span class="lyric-neighbor-label">← Previous {category}</span>
              <span
                class="lyric-neighbor-title"
                lang={previousLyric.data.alternateTitle ? "en" : previousLyric.data.lang}
                dir={previousLyric.data.alternateTitle ? "ltr" : previousLyric.data.direction}
              >
                {neighborTitle(previousLyric)}
              </span>
            </a>
          )
        }
      </div>

      <a class="lyric-neighbor-category" href={`/categories/${slugifyKalamType(category)}/`}>
        All standalone {category} · {categoryCount}
      </a>

      <div class="lyric-neighbor-slot lyric-neighbor-next">
        {
          nextLyric && (
            <a href={`/lyrics/${nextLyric.id}/`}>
              <span class="lyric-neighbor-label">Next {category} →</span>
              <span
                class="lyric-neighbor-title"
                lang={nextLyric.data.alternateTitle ? "en" : nextLyric.data.lang}
                dir={nextLyric.data.alternateTitle ? "ltr" : nextLyric.data.direction}
              >
                {neighborTitle(nextLyric)}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </article>

  <script>
    import {
      initReadingControls,
      recordRecentLyric,
    } from "../../client/reader-state";
    import { initVerseFitting } from "../../client/verse-fitting";
    import { initScanViewer } from "../../client/scan-viewer";
    import { initCorrectionDialog } from "../../client/corrections";

    const lyricPage = document.querySelector<HTMLElement>("[data-lyric-id]");
    if (lyricPage?.dataset.lyricId) {
      recordRecentLyric(lyricPage.dataset.lyricId);
    }
    initReadingControls();
    initVerseFitting();
    initScanViewer();
    initCorrectionDialog();
  </script>
</BaseLayout>
