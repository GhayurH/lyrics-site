---
// File role: Search route: loads Pagefind only here, exposes shareable URL filters, and renders removable active-filter chips.
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/search.css";
const resultTemplate = String.raw`
          <li class="pf-result">
            <div class="pf-result-card">
              <div class="pf-result-content">
                {{#if meta.collection}}
                <p class="search-result-collection">{{ meta.collection }}</p>
                {{/if}}
                <p class="pf-result-title" dir="auto">
                  <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title }}</a>
                </p>
                {{#if meta.roman_title}}
                <p class="search-result-roman-title" dir="ltr">{{ meta.roman_title }}</p>
                {{/if}}
                {{#if excerpt}}
                <p class="pf-result-excerpt" dir="auto">{{+ excerpt +}}</p>
                {{/if}}
              </div>
            </div>
          </li>
`;
---

<BaseLayout
  title="Search | Kalam Archive"
  description="Search and filter the complete Kalam Archive and Basta."
>
  <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-component-ui.js" type="module"></script>

  <section class="search-page">
    <header class="search-header">
      <p class="eyebrow">Find kalam</p>
      <h1>Search the archive</h1>
      <p>Find Urdu and Roman Urdu kalam in both collections. Use filters to narrow your results.</p>
    </header>

    <pagefind-config faceted preload lang="en" excerpt-length="25"></pagefind-config>

    <p data-requires-js role="status">Search requires JavaScript. You can still <a href="/">browse Kalam Types</a> and read the archive.</p>
    <p id="search-load-error" role="alert" hidden>Search is temporarily unavailable. Reload the page to try again, or <a href="/">browse the archive</a>.</p>

    <div class="search-input-row">
      <div class="search-input-wrap">
        <pagefind-input placeholder="Search the archive…"></pagefind-input>
      </div>
      <button id="clear-search-state" class="text-button search-clear-button" type="button">
        Clear all
      </button>
    </div>

    <details id="search-filter-disclosure" class="search-filter-disclosure" open>
      <summary>Filters</summary>
      <div class="search-primary-filters" aria-label="Search filters">
      <div class="search-filter-control search-filter-scope">
        <span class="search-filter-label">Search in</span>
        <details class="search-facet" data-search-facet="collection">
          <summary>Both archives</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find archives…" aria-label="Find Archive filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Archive choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Kalam Type</span>
        <details class="search-facet" data-search-facet="kalamType">
          <summary>All types</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find kalam types…" aria-label="Find Kalam Type filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Kalam Type choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Haal</span>
        <details class="search-facet" data-search-facet="haal">
          <summary>Any Haal</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find Haal values…" aria-label="Find Haal filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Haal choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Tags</span>
        <details class="search-facet" data-search-facet="tag">
          <summary>Any tag</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find tags…" aria-label="Find Tag filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Tag choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
      </div>
    </div>

    <details class="search-more-filters">
      <summary>More filters</summary>
      <div class="search-secondary-filters">
        <details class="search-facet" data-search-facet="language">
          <summary>Language</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find languages…" aria-label="Find Language filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Language choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
        <details class="search-facet" data-search-facet="occasion">
          <summary>Occasion</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find occasions…" aria-label="Find Occasion filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Occasion choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
        <details class="search-facet" data-search-facet="poet">
          <summary>Poet</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find poets…" aria-label="Find Poet filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Poet choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
        <details class="search-facet" data-search-facet="reciter">
          <summary>Reciter</summary>
          <div class="search-facet-panel">
            <input type="search" data-facet-query placeholder="Find reciters…" aria-label="Find Reciter filter options" autocomplete="off" />
            <div class="search-facet-options" data-facet-options role="group" aria-label="Reciter choices"></div>
            <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
          </div>
        </details>
      </div>
    </details>

    </details>

    <div id="active-search-filters" class="active-search-filters" hidden>
      <span class="search-filter-label">Active filters</span>
      <div id="active-search-filter-list" class="active-search-filter-list"></div>
    </div>

    <div class="search-results-shell">
      <p class="search-collection-note">Verified Basta kalams appear as individual kalams. Only unindexed material appears under printed pages.</p>
      <pagefind-summary></pagefind-summary>
      <pagefind-results>
        <script type="text/pagefind-template" is:inline set:html={resultTemplate}></script>
      </pagefind-results>
      <p id="search-no-results-help" class="search-no-results-help" hidden>
        No matches. Try a shorter phrase, the other script (Urdu or Roman Urdu), or
        <button id="search-clear-no-results" class="text-button" type="button">clear all filters and search again</button>.
      </p>
    </div>
  </section>

  <script>
    import { initSearchPage } from "../client/search";
    const disclosure = document.querySelector<HTMLDetailsElement>("#search-filter-disclosure");
    const wide = window.matchMedia("(min-width: 701px)");
    const syncDisclosure = () => { if (disclosure) disclosure.open = wide.matches; };
    syncDisclosure();
    wide.addEventListener("change", syncDisclosure);
    void initSearchPage();
  </script>
</BaseLayout>
