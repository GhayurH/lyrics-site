---
// File role: Search route: loads Pagefind only here, exposes shareable URL filters, and renders removable active-filter chips.
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/search.css";
---

<BaseLayout
  title="Search | Kalam Archive"
  description="Search and filter the complete Kalam Archive and Basta."
>
  <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-component-ui.js" type="module"></script>

  <section class="search-page">
    <header class="search-header">
      <p class="eyebrow">Find kalam</p>
      <h1>Search the archive</h1>
      <p>Find Urdu and Roman Urdu kalam in both collections. Use filters to narrow your results.</p>
    </header>

    <pagefind-config faceted preload lang="en" excerpt-length="25"></pagefind-config>

    <p data-requires-js role="status">Search requires JavaScript. You can still <a href="/">browse Kalam Types</a> and read the archive.</p>
    <p id="search-load-error" role="alert" hidden>Search is temporarily unavailable. Reload the page to try again, or <a href="/">browse the archive</a>.</p>

    <div class="search-input-row">
      <div class="search-input-wrap">
        <pagefind-input placeholder="Search the archive…"></pagefind-input>
      </div>
      <button id="clear-search-state" class="text-button search-clear-button" type="button">
        Clear all
      </button>
    </div>

    <details id="search-filter-disclosure" class="search-filter-disclosure" open>
      <summary>Filters</summary>
      <div class="search-primary-filters" aria-label="Search filters">
      <div class="search-filter-control search-filter-scope">
        <span class="search-filter-label">Search in</span>
        <pagefind-filter-dropdown filter="collection" label="Both archives" single-select sort="alphabetical"></pagefind-filter-dropdown>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Kalam Type</span>
        <pagefind-filter-dropdown filter="kalamType" label="Kalam Type" single-select sort="alphabetical"></pagefind-filter-dropdown>
        <span id="search-kalam-type-current" class="search-selected-filter" aria-live="polite">All types</span>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Haal</span>
        <pagefind-filter-dropdown filter="haal" label="Any Haal" single-select sort="alphabetical"></pagefind-filter-dropdown>
      </div>
      <div class="search-filter-control">
        <span class="search-filter-label">Tags</span>
        <pagefind-filter-dropdown filter="tag" label="Any tag" sort="alphabetical"></pagefind-filter-dropdown>
      </div>
    </div>

    <details class="search-more-filters">
      <summary>More filters</summary>
      <div class="search-secondary-filters">
        <pagefind-filter-dropdown filter="language" label="Language" single-select sort="alphabetical"></pagefind-filter-dropdown>
        <pagefind-filter-dropdown filter="occasion" label="Occasion" single-select sort="alphabetical"></pagefind-filter-dropdown>
        <pagefind-filter-dropdown filter="poet" label="Poet" single-select sort="alphabetical"></pagefind-filter-dropdown>
        <pagefind-filter-dropdown filter="reciter" label="Reciter" single-select sort="alphabetical"></pagefind-filter-dropdown>
      </div>
    </details>

    </details>

    <div id="active-search-filters" class="active-search-filters" hidden>
      <span class="search-filter-label">Active filters</span>
      <div id="active-search-filter-list" class="active-search-filter-list"></div>
    </div>

    <div class="search-results-shell">
      <p class="search-collection-note">Each standalone result is a kalam. Each Basta result is a printed page, which may contain several selections.</p>
      <pagefind-summary></pagefind-summary>
      <pagefind-results>
        <script type="text/pagefind-template" is:inline>
          <li class="pf-result">
            <div class="pf-result-card">
              <div class="pf-result-content">
                {{#if meta.collection}}
                <p class="pf-result-collection">{{ meta.collection }}</p>
                {{/if}}
                <p class="pf-result-title" dir="auto">
                  <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title }}</a>
                </p>
                {{#if meta.roman_title}}
                <p class="pf-result-roman-title" dir="ltr">{{ meta.roman_title }}</p>
                {{/if}}
                {{#if excerpt}}
                <p class="pf-result-excerpt" dir="auto">{{+ excerpt +}}</p>
                {{/if}}
              </div>
            </div>
          </li>
        </script>
      </pagefind-results>
      <p id="search-no-results-help" class="search-no-results-help" hidden>
        No matches. Try a shorter phrase, the other script (Urdu or Roman Urdu), or
        <button id="search-clear-no-results" class="text-button" type="button">clear all filters and search again</button>.
      </p>
    </div>
  </section>

  <script>
    import { initSearchPage } from "../client/search";
    const disclosure = document.querySelector<HTMLDetailsElement>("#search-filter-disclosure");
    const wide = window.matchMedia("(min-width: 701px)");
    const syncDisclosure = () => { if (disclosure) disclosure.open = wide.matches; };
    syncDisclosure();
    wide.addEventListener("change", syncDisclosure);
    void initSearchPage();
  </script>
</BaseLayout>
