---
// File role: Native search form, facets and result shell; the public Pagefind API supplies results.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SEARCH_FACETS } from "../lib/search-state";
import "../styles/search.css";
const searchVersion = Date.now().toString(36);
---

<BaseLayout title="Search | Kalam Archive" description="Search the Kalam Archive and Basta by title, remembered verse, poet, language or occasion.">
  <section class="search-page" data-search-version={searchVersion}>
    <header class="search-header">
      <p class="eyebrow">Find kalam</p>
      <h1>Search the archive</h1>
      <p>Search a title or a remembered verse in its original script or Roman transcription.</p>
      <nav class="search-browse-links" aria-label="Browse the archive">
        <a href="/poets/">Poets</a><a href="/languages/">Languages</a><a href="/occasions/">Occasions</a>
      </nav>
    </header>

    <p data-requires-js role="status">Search requires JavaScript. You can still <a href="/">browse Kalam Types</a>, <a href="/poets/">browse poets</a> and read the archive.</p>
    <div id="search-load-error" role="alert" hidden>
      <p>Search is temporarily unavailable. Try again, or <a href="/">browse the archive</a>.</p>
      <button id="search-retry" class="text-button" type="button">Retry search</button>
    </div>

    <form id="search-form" class="search-input-row" action="/search/" method="get" role="search">
      <div class="search-input-wrap">
        <label class="visually-hidden" for="search-query">Search the archive</label>
        <input id="search-query" name="q" type="search" placeholder="Search the archive…" maxlength="500" autocomplete="off" dir="auto" />
      </div>
      <button type="submit" class="search-submit">Search</button>
      <button id="clear-search-state" class="text-button search-clear-button" type="button">Clear all</button>
    </form>

    <details id="search-filter-disclosure" class="search-filter-disclosure" open>
      <summary>Filters</summary>
      <div class="search-primary-filters" aria-label="Search filters">
        {SEARCH_FACETS.filter(facet => facet.primary).map(facet => (
          <div class="search-filter-control">
            <span class="search-filter-label">{facet.label}</span>
            <details class="search-facet" data-search-facet={facet.key}>
              <summary>{facet.empty}</summary>
              <div class="search-facet-panel">
                <input type="search" data-facet-query placeholder={`Find ${facet.label.toLowerCase()}…`} aria-label={`Find ${facet.label} filter options`} autocomplete="off" />
                <div class="search-facet-options" data-facet-options role="group" aria-label={`${facet.label} choices`}></div>
                <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
              </div>
            </details>
          </div>
        ))}
      </div>
      <details class="search-more-filters">
        <summary>More filters</summary>
        <div class="search-secondary-filters">
          {SEARCH_FACETS.filter(facet => !facet.primary).map(facet => (
            <details class="search-facet" data-search-facet={facet.key}>
              <summary>{facet.label}</summary>
              <div class="search-facet-panel">
                <input type="search" data-facet-query placeholder={`Find ${facet.label.toLowerCase()}…`} aria-label={`Find ${facet.label} filter options`} autocomplete="off" />
                <div class="search-facet-options" data-facet-options role="group" aria-label={`${facet.label} choices`}></div>
                <p class="search-facet-hint" data-facet-hint aria-live="polite"></p>
              </div>
            </details>
          ))}
        </div>
      </details>
    </details>

    <div id="active-search-filters" class="active-search-filters" hidden>
      <span class="search-filter-label">Active filters</span>
      <div id="active-search-filter-list" class="active-search-filter-list"></div>
    </div>
    <div class="search-results-shell">
      <p class="search-collection-note">Basta kalams appear individually. Unindexed material links to its printed page.</p>
      <p id="search-summary" role="status" aria-live="polite" tabindex="-1">Loading search…</p>
      <ol id="search-results" aria-label="Search results" aria-busy="true"></ol>
      <nav id="search-pagination" class="search-pagination" aria-label="Search result pages" hidden></nav>
      <p id="search-no-results-help" class="search-no-results-help" hidden>
        Try a shorter phrase or another spelling, or
        <button id="search-clear-no-results" class="text-button" type="button">clear all filters and search again</button>.
      </p>
    </div>
  </section>
  <script>
    import { initSearchPage } from "../client/search";
    const disclosure = document.querySelector<HTMLDetailsElement>("#search-filter-disclosure");
    const wide = window.matchMedia("(min-width: 701px)");
    const syncDisclosure = () => { if (disclosure) disclosure.open = wide.matches; };
    syncDisclosure();
    wide.addEventListener("change", syncDisclosure);
    void initSearchPage();
  </script>
</BaseLayout>
