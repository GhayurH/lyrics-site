---
// File role: Minimal global site shell: fonts, core CSS, metadata, navigation, theme bootstrap, and global browser enhancements.
import "@fontsource/noto-nastaliq-urdu/400.css";
import "@fontsource/noto-nastaliq-urdu/700.css";
import "../styles/core.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A searchable collection of lyrics.",
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const path = Astro.url.pathname;
const browseActive =
  path === "/" || path.startsWith("/lyrics/") || path.startsWith("/categories/");
const bastaActive = path.startsWith("/basta/");
const searchActive = path.startsWith("/search/");
const savedActive = path.startsWith("/saved/");
const aboutActive = path.startsWith("/about/");
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark" data-pf-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Set the saved theme before first paint to avoid a light/dark flash. -->
    <script is:inline>
      (() => {
        let theme = "dark";
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") theme = savedTheme;
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.pfTheme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a class="site-title" href="/">Kalam Archive</a>

        <div class="header-actions">
          <nav aria-label="Main navigation">
            <a href="/" aria-current={browseActive ? "page" : undefined}>Browse</a>
            <a href="/basta/" aria-current={bastaActive ? "page" : undefined}>Basta</a>
            <a href="/search/" aria-current={searchActive ? "page" : undefined}>Search</a>
            <a href="/saved/" aria-current={savedActive ? "page" : undefined}>Saved</a>
            <a href="/about/" aria-current={aboutActive ? "page" : undefined}>About / Contact</a>
          </nav>

          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Switch colour theme"
            aria-pressed="true"
          >
            Light mode
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer" data-pagefind-ignore>
      <p>
        Kalam Archive · <a href="/saved/">Saved &amp; recent</a> · <a href="/about/">About / Contact</a>
      </p>
    </footer>

    <script>
      import { initSiteShell } from "../client/site";
      initSiteShell();
    </script>
  </body>
</html>
