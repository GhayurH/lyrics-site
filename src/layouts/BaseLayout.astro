---
// File role: Minimal global site shell: fonts, core CSS, metadata, navigation, theme bootstrap, and global browser enhancements.
import "@fontsource/noto-nastaliq-urdu/400.css";
import "@fontsource/noto-nastaliq-urdu/700.css";
import "@fontsource/noto-naskh-arabic/400.css";
import "@fontsource/noto-naskh-arabic/700.css";
// Alternate faces are code-split and registered only when selected.
import { FONT_CHOICES } from "../client/fonts";
import { PRESET_THEME_NAMES, DARK_THEME_NAMES } from "../client/theme";
import AppearanceDialog from "../components/AppearanceDialog.astro";
import "../styles/core.css";
import "../styles/appearance.css";


interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A searchable collection of lyrics.",
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const path = Astro.url.pathname;
const browseActive =
  path === "/" || path.startsWith("/lyrics/") || path.startsWith("/categories/");
const bastaActive = path.startsWith("/basta/");
const searchActive = path.startsWith("/search/");
const savedActive = path.startsWith("/saved/");
const reciteActive = path.startsWith("/recite/");
const aboutActive = path.startsWith("/about/");
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="auto" data-pf-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171719" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Restore appearance before first paint, including the custom palette. -->
    <script is:inline define:vars={{ fontOptions: {
      urdu: FONT_CHOICES.urdu.map((choice) => choice.value),
      roman: FONT_CHOICES.roman.map((choice) => choice.value),
    }, presetThemes: PRESET_THEME_NAMES, darkThemes: DARK_THEME_NAMES }}>
      (() => {
        const root = document.documentElement;
        let savedMode;
        try { savedMode = localStorage.getItem("theme"); } catch {}
        const mode = [...presetThemes, "custom"].includes(savedMode)
          ? savedMode : "auto";
        root.dataset.jsAvailable = "true";
        root.dataset.theme = mode;
        // Restore saved font choice before paint independently of colour themes.
        try {
          const fonts = JSON.parse(localStorage.getItem("kalam:reading-fonts") || "{}");
          if (fonts && typeof fonts === "object") {
            if (fontOptions.urdu.includes(fonts.urdu)) root.dataset.urduFont = fonts.urdu;
            const roman = fonts.roman === "system" ? "sans" : fonts.roman;
            if (fontOptions.roman.includes(roman)) root.dataset.romanFont = roman;
          }
        } catch { /* Storage may be blocked or invalid. */ }
        if (mode === "custom") {
          let saved = {};
          try { saved = JSON.parse(localStorage.getItem("kalam:custom-theme") || "{}") || {}; } catch {}
          const pick = (key, fallback) => typeof saved[key] === "string" && /^#[0-9a-f]{6}$/i.test(saved[key])
            ? saved[key].toLowerCase() : fallback;
          const main = pick("main", "#f4ead6");
          const secondary = pick("secondary", "#fbf4e6");
          const accent = pick("accent", "#755238");
          const luminance = (hex) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
            .map((v) => v <= .04045 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4)
            .reduce((total, v, i) => total + v * [.2126, .7152, .0722][i], 0);
          const contrast = (a, b) => (Math.max(a, b) + .05) / (Math.min(a, b) + .05);
          const backgrounds = [luminance(main), luminance(secondary)];
          const dark = luminance("#171719");
          const darkContrast = Math.min(...backgrounds.map((v) => contrast(v, dark)));
          const lightContrast = Math.min(...backgrounds.map((v) => contrast(v, 1)));
          const foreground = darkContrast >= lightContrast ? "#171719" : "#ffffff";
          const scheme = contrast(backgrounds[0], dark) >= contrast(backgrounds[0], 1) ? "light" : "dark";
          const accentText = contrast(luminance(accent), 1) >= contrast(luminance(accent), dark)
            ? "#ffffff" : "#171719";
          const optional = (key) => typeof saved[key] === "string" && /^#[0-9a-f]{6}$/i.test(saved[key])
            ? saved[key].toLowerCase() : null;
          // A Custom palette copied from a preset must retain its exact
          // foregrounds on reload. Only use these Auto seeds while both
          // background surfaces still match the original preset.
          const source = saved.inherited;
          const inherited = source && typeof source === "object" &&
            ["main", "secondary", "primary", "muted", "borders"].every(
              (key) => typeof source[key] === "string" && /^#[0-9a-f]{6}$/i.test(source[key])
            ) && source.main.toLowerCase() === main &&
            source.secondary.toLowerCase() === secondary ? source : null;
          const blend = (first, second, share) => "#" + [1, 3, 5].map((i) =>
            Math.round(parseInt(first.slice(i, i + 2), 16) * share +
              parseInt(second.slice(i, i + 2), 16) * (1 - share)).toString(16).padStart(2, "0")).join("");
          const minContrast = (text) => Math.min(...backgrounds.map((value) => contrast(luminance(text), value)));
          const primary = optional("primaryText") || inherited?.primary.toLowerCase() || foreground;
          let muted = foreground;
          const average = blend(main, secondary, .5);
          for (let share = .95; share >= .05; share -= .05) {
            const candidate = blend(foreground, average, share);
            if (minContrast(candidate) < 4.5) break;
            muted = candidate;
          }
          muted = optional("mutedText") || inherited?.muted.toLowerCase() || muted;
          const border = optional("borders");
          root.style.setProperty("--theme-border-auto",
            inherited?.borders.toLowerCase() || blend(foreground, main, .22));
          if (border) root.style.setProperty("--theme-border", border);
          for (const [key, value] of Object.entries({
            "--theme-main": main, "--theme-secondary": secondary,
            "--theme-accent": accent, "--theme-foreground": primary,
            "--theme-muted": muted, "--theme-accent-text": accentText,
            "--theme-color-scheme": scheme,
          })) root.style.setProperty(key, value);
          root.dataset.pfTheme = scheme;
        } else {
          root.dataset.pfTheme = (mode === "auto" ? matchMedia("(prefers-color-scheme: dark)").matches : darkThemes.includes(mode)) ? "dark" : "light";
        }
        const background = getComputedStyle(root).getPropertyValue("--site-background").trim();
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content",
          mode === "custom" ? root.style.getPropertyValue("--theme-main")
          : /^#[0-9a-f]{6}$/i.test(background) ? background : "#171719");
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a class="site-title" href="/">Kalam Archive</a>

        <div class="header-actions">
          <button
            id="mobile-nav-toggle"
            class="mobile-nav-toggle"
            type="button"
            aria-controls="site-navigation"
            aria-expanded="false"
            aria-label="Open navigation"
            title="Open navigation"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
          <nav id="site-navigation" aria-label="Main navigation">
            <a href="/" aria-current={browseActive ? "page" : undefined}>Browse</a>
            <a href="/basta/" aria-current={bastaActive ? "page" : undefined}>Basta</a>
            <a href="/search/" aria-current={searchActive ? "page" : undefined}>Search</a>
            <a href="/recite/" aria-current={reciteActive ? "page" : undefined}>Recite</a>
            <a href="/saved/" aria-current={savedActive ? "page" : undefined}>Saved</a>
            <a href="/about/" aria-current={aboutActive ? "page" : undefined}>About / Contact</a>
          </nav>

          <button id="theme-toggle" class="theme-toggle" type="button"
            aria-label="Appearance settings" aria-haspopup="dialog" aria-controls="theme-dialog" title="Appearance settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 0 0 18c1.3 0 2.2-1.1 2.2-2.3 0-.9-.5-1.4-.5-2.2 0-1 1-1.5 2-1.5H19" />
              <circle cx="6.5" cy="11" r="1" /><circle cx="9" cy="6.8" r="1" />
              <circle cx="14.5" cy="7" r="1" /><circle cx="17.5" cy="11" r="1" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <AppearanceDialog />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer" data-pagefind-ignore>
      <div class="site-footer-inner">
        <div class="site-footer-about">
          <a class="site-footer-title" href="/">Kalam Archive</a>
          <p>Urdu kalam, Roman Urdu transcriptions and the Basta book archive.</p>
        </div>
        <nav class="site-footer-nav" aria-label="Footer navigation">
          <a href="/">Browse</a>
          <a href="/basta/">Basta</a>
          <a href="/search/">Search</a>
          <a href="/recite/">Recite</a>
          <a href="/saved/">Saved &amp; recent</a>
          <a href="/about/">About / Contact</a>
        </nav>
      </div>
    </footer>

    <script>
      import { initSiteShell } from "../client/site";
      initSiteShell();
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => { void navigator.serviceWorker.register("/sw.js").catch(() => {}); }, { once: true });
      }
    </script>
  </body>
</html>
